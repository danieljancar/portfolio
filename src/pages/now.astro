---
import NotesList from '~/components/lists/NotesList.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getNotes, getSettings } from '~/lib/content';

const [settings, notes] = await Promise.all([getSettings(), getNotes()]);
---

<BaseLayout
  title="Now"
  description="What Daniel Jancar is doing right now, and short updates."
>
  <SectionHead title="Now" as="h1" />
  <p class="now wrap">{settings.now}</p>
  {notes.length > 0 && (
    <>
      <SectionHead title="Updates" />
      <NotesList notes={notes} />
    </>
  )}
</BaseLayout>

<style>
  .now {
    max-width: 30ch;
    font-size: clamp(28px, 3.4vw, 48px);
    font-weight: 300;
    font-stretch: 62%;
    line-height: 1.1;
  }
</style>
