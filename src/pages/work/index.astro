---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import WorkList from '~/components/home/WorkList.astro';
import { getExperience, getProjects, getSettings } from '~/lib/content';
import { formatYearMonth } from '~/lib/dates';

const [projects, experience, settings] = await Promise.all([
  getProjects(),
  getExperience(),
  getSettings(),
]);
const period = (start?: string, end?: string) =>
  [start ? formatYearMonth(start) : null, end ? formatYearMonth(end) : 'now']
    .filter(Boolean)
    .join(' – ');
---

<BaseLayout
  title="Work"
  description="Projects and experience of Daniel Jancar."
>
  <SectionHead title="Work">
    <span>{projects.length} projects</span>
  </SectionHead>
  <WorkList projects={projects} />

  <SectionHead title="Experience" />
  <div class="about wrap">
    <p>{settings.about}</p>
  </div>
  <ol class="jobs wrap">
    {experience.map(job => (
      <li>
        <span class="mono">{period(job.data.start, job.data.end)}</span>
        <div>
          <h3>{job.data.role}</h3>
          <p class="company">
            {job.data.companyUrl ? (
              <a href={job.data.companyUrl}>{job.data.company}</a>
            ) : (
              job.data.company
            )}
          </p>
          {job.data.summary && <p class="summary">{job.data.summary}</p>}
          {job.data.stack.length > 0 && (
            <p class="mono stack">{job.data.stack.join(' · ')}</p>
          )}
        </div>
      </li>
    ))}
  </ol>
</BaseLayout>

<style>
  .about p {
    max-width: 60ch;
    font-size: 20px;
    line-height: 1.5;
  }

  .jobs {
    margin: 40px 0 96px;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }

  h3 {
    font-size: 28px;
    font-stretch: 125%;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .company {
    margin-top: 4px;
    font-weight: 500;
  }

  .summary {
    max-width: 70ch;
    margin-top: 12px;
    color: var(--ink-soft);
  }

  .stack {
    margin-top: 12px;
  }

  @media (max-width: 700px) {
    li {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
