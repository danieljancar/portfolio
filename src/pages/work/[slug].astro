---
import Cover from '~/components/media/Cover.astro';
import { render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import TagList from '~/components/ui/TagList.astro';
import RelatedList from '~/components/ui/RelatedList.astro';
import { getRelated } from '~/lib/tags';
import { getProjects } from '~/lib/content';
import '~/styles/prose.css';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const related = await getRelated('project', project.id, { limit: 8 });
const status = {
  live: 'Live',
  'in-progress': 'In progress',
  archived: 'Archived',
}[project.data.status];
---

<BaseLayout
  title={project.data.name}
  description={project.data.tagline}
  image={project.data.cover?.src}
>
  <header class="head wrap">
    <div>
      <div class="mono">
        {[project.data.kind, status, project.data.year]
          .filter(Boolean)
          .join(' · ')}
      </div>
      <h1 class="display">{project.data.name}</h1>
      <p class="tagline">{project.data.tagline}</p>
    </div>
    <div
      class:list={[
        'shape',
        `shape-${project.data.shape}`,
        !project.data.cover && 'empty',
      ]}
    >
      {project.data.cover && (
        <Cover
          src={project.data.cover}
          alt={project.data.coverAlt}
          widths={[500, 900]}
          sizes="400px"
          loading="eager"
        />
      )}
    </div>
  </header>
  <div class="body wrap">
    <div class="prose">
      <Content />
    </div>
    <aside>
      {project.data.tags.length > 0 && (
        <div>
          <span class="mono soft">Tags</span>
          <TagList tags={project.data.tags} />
        </div>
      )}
      {project.data.stack.length > 0 && (
        <div>
          <span class="mono soft">Stack</span>
          <ul class="stack">
            {project.data.stack.map(s => (
              <li class="mono">{s}</li>
            ))}
          </ul>
        </div>
      )}
      {project.data.links.length > 0 && (
        <div>
          <span class="mono soft">Links</span>
          <ul class="links">
            {project.data.links.map(l => (
              <li>
                <a href={l.href}>{l.label} ↗</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
  <RelatedList items={related} title="Connected" />
  <div class="space"></div>
</BaseLayout>

<style>
  .head {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 40px;
    align-items: end;
    padding-top: 64px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }

  h1 {
    margin-top: 12px;
    font-size: clamp(56px, 10vw, 160px);
  }

  .tagline {
    margin-top: 16px;
    font-size: 24px;
  }

  .shape {
    height: 400px;
    overflow: hidden;
  }

  .empty {
    background: var(--accent);
  }

  a:hover {
    color: var(--accent-text);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 680px) 1fr;
    gap: 64px;
    padding-top: 48px;
  }

  aside {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .soft {
    color: var(--ink-soft);
  }

  ul {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .stack li {
    padding: 4px 8px;
    border: 1px solid var(--line);
  }

  .links li + li {
    margin-top: 8px;
  }

  .links a {
    font-size: 20px;
    font-weight: 600;
  }

  .space {
    height: 96px;
  }

  @media (max-width: 900px) {
    .head,
    .body {
      grid-template-columns: 1fr;
    }

    .shape {
      max-width: 300px;
      height: 300px;
    }
  }
</style>
