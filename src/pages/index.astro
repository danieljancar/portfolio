---
import AlbumCard from '~/components/cards/AlbumCard.astro';
import PostCard from '~/components/cards/PostCard.astro';
import ProjectCard from '~/components/cards/ProjectCard.astro';
import Hero from '~/components/home/Hero.astro';
import ZoomIn from '~/components/home/ZoomIn.astro';
import ButtonLink from '~/components/ui/ButtonLink.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getPosts, getProjects, getSettings } from '~/lib/content';
import { getAlbums, getHighlights, getPhotos } from '~/lib/photos';

const [settings, projects, posts, albums, highlights] = await Promise.all([
  getSettings(),
  getProjects(),
  getPosts(),
  getAlbums(),
  getHighlights(),
]);

const heroPhotos = await getPhotos(settings.heroPhotos);
const [zoomCenter, ...rest] = highlights.filter(
  photo => !settings.heroPhotos.includes(photo.id),
);
const zoomAlbum = albums.find(album => album.id === zoomCenter?.album);
const [leadProject, ...otherProjects] = [...projects].sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);
---

<BaseLayout>
  <Hero
    headline={settings.headline}
    intro={settings.intro}
    photos={heroPhotos}
  />

  <section class="container block">
    <SectionHead title="Projects" href="/projects" linkLabel="All projects" />
    <div class="projects">
      {leadProject && <ProjectCard project={leadProject} large />}
      <div class="side">
        {otherProjects.slice(0, 2).map(project => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  {zoomCenter && zoomAlbum && (
    <ZoomIn center={zoomCenter} around={rest.slice(0, 4)} album={zoomAlbum} />
  )}

  <section class="container block">
    <SectionHead title="Blog" href="/blog" linkLabel="All posts" />
    <div class="posts">
      {posts.slice(0, 3).map(post => (
        <PostCard post={post} />
      ))}
    </div>
  </section>

  <section class="container block">
    <SectionHead title="Photos" href="/photos" linkLabel="All photos" />
    <div class="albums">
      {albums.slice(0, 2).map(album => (
        <AlbumCard album={album} />
      ))}
    </div>
  </section>

  <section class="container block about">
    {settings.portrait && (
      <div class="portrait">
        <Image
          src={settings.portrait}
          alt={settings.portraitAlt}
          widths={[400, 700, 1000]}
          sizes="(max-width: 860px) 80vw, 30vw"
        />
      </div>
    )}
    <div>
      <p class="eyebrow">Right now</p>
      <h2>{settings.now}</h2>
      <div class="actions">
        <ButtonLink href="/about">Experience and skills</ButtonLink>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .block {
    padding-top: clamp(72px, 10vw, 140px);
  }

  .projects {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(24px, 3vw, 40px);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 40px);
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 36px);
  }

  .albums {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
  }

  .portrait {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about h2 {
    margin-top: 14px;
    font-size: clamp(30px, 3.6vw, 48px);
  }

  .actions {
    margin-top: 32px;
  }

  @media (max-width: 860px) {
    .projects,
    .about,
    .albums {
      grid-template-columns: 1fr;
    }

    .posts {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: 360px;
    }
  }
</style>
