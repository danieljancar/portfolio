---
import { render } from 'astro:content';
import Cover from '~/components/media/Cover.astro';
import ButtonLink from '~/components/ui/ButtonLink.astro';
import RelatedList from '~/components/ui/RelatedList.astro';
import TagList from '~/components/ui/TagList.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getProjects } from '~/lib/content';
import { getRelated } from '~/lib/tags';
import '~/styles/prose.css';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const related = await getRelated('project', project.id, { limit: 8 });
const {
  name,
  tagline,
  kind,
  status,
  year,
  role,
  stack,
  tags,
  links,
  cover,
  coverAlt,
} = project.data;
const statusLabel = {
  live: 'Live',
  'in-progress': 'In progress',
  archived: 'Archived',
}[status];
const facts = [
  { label: 'Type', value: kind },
  { label: 'Year', value: year?.toString() },
  { label: 'Status', value: statusLabel },
  { label: 'Role', value: role },
].filter((fact): fact is { label: string; value: string } =>
  Boolean(fact.value),
);
---

<BaseLayout title={name} description={tagline} image={cover?.src}>
  <article>
    <header class="container head">
      <a class="back" href="/projects">
        ← Projects
      </a>
      <h1>{name}</h1>
      <p class="tagline">{tagline}</p>
      <dl class="facts">
        {facts.map(fact => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    {cover && (
      <div class="container">
        <div class="cover">
          <Cover
            src={cover}
            alt={coverAlt}
            widths={[800, 1400, 2200]}
            sizes="(max-width: 1400px) 100vw, 1320px"
            loading="eager"
          />
        </div>
      </div>
    )}

    <div class="container body">
      <div class="prose">
        <Content />
      </div>
      <aside>
        {links.length > 0 && (
          <div class="links">
            {links.map((link, i) => (
              <ButtonLink
                href={link.href}
                variant={i === 0 ? 'solid' : 'outline'}
              >
                {link.label} ↗
              </ButtonLink>
            ))}
          </div>
        )}
        {stack.length > 0 && (
          <div>
            <h2>Built with</h2>
            <ul class="stack">
              {stack.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}
        {tags.length > 0 && (
          <div>
            <h2>Tags</h2>
            <TagList tags={tags} />
          </div>
        )}
      </aside>
    </div>
  </article>

  <RelatedList items={related} title="Connected" />
</BaseLayout>

<style>
  .head {
    padding-top: clamp(40px, 6vw, 80px);
  }

  .back {
    font-weight: 500;
    color: var(--ink-soft);
  }

  .back:hover {
    color: var(--accent-text);
  }

  h1 {
    margin-top: 20px;
    font-size: clamp(52px, 9vw, 128px);
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .tagline {
    max-width: 40ch;
    margin-top: 20px;
    font-size: clamp(20px, 2vw, 26px);
    color: var(--ink-soft);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 40px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  dt {
    font-size: 14px;
    color: var(--ink-soft);
  }

  dd {
    margin: 4px 0 0;
    font-weight: 600;
  }

  .cover {
    margin-top: 48px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 680px) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    padding-top: 56px;
  }

  aside {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  aside h2 {
    margin-bottom: 12px;
    font-size: 16px;
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink-soft);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--surface);
    font-size: 14px;
    font-weight: 500;
  }

  @media (max-width: 860px) {
    .body {
      grid-template-columns: 1fr;
    }
  }
</style>
