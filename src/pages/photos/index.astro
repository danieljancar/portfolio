---
import AlbumCard from '~/components/cards/AlbumCard.astro';
import Gallery from '~/components/media/Gallery.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getAlbums } from '~/lib/photos';

const albums = await getAlbums();
const photos = albums.flatMap(album => album.photos);
---

<BaseLayout
  title="Photos"
  description="Photos by Daniel Jancar."
  image={albums[0]?.data.cover.src}
>
  <section class="container page">
    <SectionHead title="Photos" as="h1" />
    <div class="albums">
      {albums.map(album => (
        <AlbumCard album={album} />
      ))}
    </div>
    <h2 class="all">All photos</h2>
    <Gallery photos={photos} label="Photo by Daniel Jancar" />
  </section>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(48px, 7vw, 96px);
  }

  .albums {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
  }

  @media (max-width: 760px) {
    .albums {
      grid-template-columns: 1fr;
    }
  }

  .all {
    margin: clamp(64px, 8vw, 112px) 0 28px;
    font-size: clamp(32px, 4vw, 48px);
  }
</style>
