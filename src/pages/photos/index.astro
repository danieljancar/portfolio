---
import PhotoGrid from '~/components/media/PhotoGrid.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getAlbums } from '~/lib/photos';

const albums = await getAlbums();
const photos = albums.flatMap(album => album.photos);
---

<BaseLayout
  title="Photos"
  description="Photos by Daniel Jancar."
  image={albums[0]?.data.cover}
>
  <SectionHead title="Photos" as="h1" />
  <div class="filters wrap" role="group" aria-label="Albums">
    <button type="button" data-filter="all" aria-pressed="true">
      All
    </button>
    {albums.map(album => (
      <button type="button" data-filter={album.id} aria-pressed="false">
        {album.data.title}
      </button>
    ))}
    <a class="mono open" href="/photos" data-open hidden>
      Open album →
    </a>
  </div>
  <PhotoGrid photos={photos} label="Photo by Daniel Jancar" />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-album]');
  const open = document.querySelector<HTMLAnchorElement>('[data-open]');

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'all';
      for (const other of buttons) {
        other.setAttribute('aria-pressed', String(other === button));
      }
      for (const item of items) {
        item.hidden = filter !== 'all' && item.dataset.album !== filter;
      }
      if (open) {
        open.hidden = filter === 'all';
        open.href = `/photos/${filter}`;
      }
    });
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  button {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    font: 500 14px var(--font-sans);
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  button[aria-pressed='true'],
  button:hover {
    background: var(--ink);
    color: var(--ground);
  }

  .open {
    margin-left: 8px;
  }
</style>
