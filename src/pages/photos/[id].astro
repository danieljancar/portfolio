---
import { getEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Photo from '~/components/media/Photo.astro';
import TagList from '~/components/ui/TagList.astro';
import RelatedList from '~/components/ui/RelatedList.astro';
import { getRelated } from '~/lib/tags';
import { themeStyle } from '~/lib/color';
import { formatDate } from '~/lib/dates';
import { cameraLine, getPhotos, photoTitle } from '~/lib/photos';

export async function getStaticPaths() {
  const photos = await getPhotos();
  return photos.map((photo, i) => ({
    params: { id: photo.id },
    props: {
      photo,
      prev: photos[i - 1] ?? photos[photos.length - 1],
      next: photos[i + 1] ?? photos[0],
    },
  }));
}

const { photo, prev, next } = Astro.props;
const event = photo.data.event ? await getEntry(photo.data.event) : undefined;
const taken =
  photo.data.date ??
  (photo.meta.exif.takenAt ? new Date(photo.meta.exif.takenAt) : undefined);
const heading =
  photo.data.title ?? photo.data.place ?? (taken ? formatDate(taken) : 'Photo');
const related = await getRelated('photo', photo.id, { limit: 8 });
const swatches = Object.entries(photo.meta.palette).filter(
  ([k, v]) => v && k !== 'dominant',
) as [string, string][];
---

<BaseLayout
  title={photoTitle(photo)}
  description={photo.data.alt}
  image={photo.data.image.src}
  themeStyle={themeStyle(photo.theme)}
>
  <section class="page">
    <div class="frame">
      <Photo
        photo={photo}
        widths={[800, 1400, 2000, 2800]}
        sizes="(max-width: 900px) 100vw, 70vw"
        loading="eager"
      />
    </div>
    <div class="info">
      <div class="mono">
        {[taken && formatDate(taken), photo.data.place]
          .filter(Boolean)
          .join(' · ')}
      </div>
      <h1 class="display">{heading}</h1>
      <p>{photo.data.alt}</p>
      {(photo.meta.exif.camera || cameraLine(photo)) && (
        <dl class="mono">
          {photo.meta.exif.camera && (
            <>
              <dt>Camera</dt>
              <dd>{photo.meta.exif.camera}</dd>
            </>
          )}
          {photo.meta.exif.lens && (
            <>
              <dt>Lens</dt>
              <dd>{photo.meta.exif.lens}</dd>
            </>
          )}
          {cameraLine(photo) && (
            <>
              <dt>Settings</dt>
              <dd>{cameraLine(photo)}</dd>
            </>
          )}
        </dl>
      )}
      <div class="swatches" aria-label="Colours in this photo">
        {swatches.map(([name, hex]) => (
          <span title={`${name} ${hex}`} style={`background:${hex}`}></span>
        ))}
      </div>
      <TagList tags={photo.data.tags} />
      {event && (
        <a class="mono" href={`/events/${event.id}`}>
          From {event.data.title} →
        </a>
      )}
      <nav class="pager mono" aria-label="More photos">
        <a href={`/photos/${prev.id}`}>← Previous</a>
        <a href="/photos">All photos</a>
        <a href={`/photos/${next.id}`}>Next →</a>
      </nav>
    </div>
  </section>
  <RelatedList items={related} title="More like this" />
</BaseLayout>

<style>
  .page {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(280px, 3fr);
    gap: 32px;
    min-height: calc(100vh - var(--bar-height));
    padding: var(--gutter);
    background: var(--tint);
    color: var(--tint-ink);
    transition: background 0.6s;
  }

  .frame {
    max-height: calc(100vh - var(--bar-height) - 2 * var(--gutter));
  }

  .frame :global(img) {
    height: 100%;
    max-height: calc(100vh - var(--bar-height) - 2 * var(--gutter));
    object-fit: contain;
    background: transparent !important;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-self: end;
  }

  h1 {
    font-size: clamp(36px, 4vw, 64px);
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
    margin: 0;
  }

  dt {
    opacity: 0.7;
  }

  dd {
    margin: 0;
  }

  .swatches {
    display: flex;
    gap: 6px;
  }

  .swatches span {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.3);
  }

  a {
    color: inherit;
  }

  a:hover {
    color: var(--wash);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid currentColor;
  }

  @media (max-width: 900px) {
    .page {
      grid-template-columns: 1fr;
    }
  }
</style>
