---
import { getEntry, render } from 'astro:content';
import Toc from '~/components/blog/Toc.astro';
import Cover from '~/components/media/Cover.astro';
import RelatedList from '~/components/ui/RelatedList.astro';
import TagList from '~/components/ui/TagList.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getPosts, readingTime } from '~/lib/content';
import { formatDate } from '~/lib/dates';
import { getRelated } from '~/lib/tags';
import '~/styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const project = post.data.project
  ? await getEntry(post.data.project)
  : undefined;
const related = await getRelated('post', post.id, { limit: 4 });
const { title, description, published, updated, cover, coverAlt, tags } =
  post.data;
---

<BaseLayout title={title} description={description} image={cover?.src}>
  <div class="progress" aria-hidden="true"></div>
  <article>
    <header class="container head">
      <a class="back" href="/blog">
        ← Blog
      </a>
      <p class="meta">
        <time datetime={published.toISOString()}>{formatDate(published)}</time>
        <span>{readingTime(post.body)} min read</span>
        {updated && <span>Updated {formatDate(updated)}</span>}
      </p>
      <h1>{title}</h1>
      <p class="description">{description}</p>
    </header>

    {cover && (
      <div class="container">
        <div class="cover">
          <Cover
            src={cover}
            alt={coverAlt}
            widths={[800, 1400, 2200]}
            sizes="(max-width: 1400px) 100vw, 1320px"
            loading="eager"
          />
        </div>
      </div>
    )}

    <div class="container layout">
      <div class="prose">
        <Content />
      </div>
      <aside>
        <Toc headings={headings} />
        {project && (
          <div>
            <h2>Project</h2>
            <a class="project" href={`/projects/${project.id}`}>
              {project.data.name} →
            </a>
          </div>
        )}
        {tags.length > 0 && (
          <div>
            <h2>Tags</h2>
            <TagList tags={tags} />
          </div>
        )}
      </aside>
    </div>
  </article>

  <RelatedList items={related} title="Read next" />
</BaseLayout>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .head {
    max-width: calc(900px + 2 * var(--gutter));
    padding-top: clamp(40px, 6vw, 80px);
    text-align: center;
  }

  .back {
    font-weight: 500;
    color: var(--ink-soft);
  }

  .back:hover {
    color: var(--accent-text);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 20px;
    margin-top: 28px;
    font-size: 15px;
    font-weight: 500;
    color: var(--accent-text);
  }

  h1 {
    margin-top: 16px;
    font-size: clamp(38px, 5.6vw, 72px);
    letter-spacing: -0.035em;
  }

  .description {
    margin-top: 20px;
    font-size: clamp(19px, 1.8vw, 22px);
    color: var(--ink-soft);
  }

  .cover {
    margin-top: 48px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 700px) minmax(0, 280px);
    justify-content: center;
    gap: clamp(40px, 6vw, 96px);
    padding-top: 56px;
  }

  aside {
    position: sticky;
    top: calc(var(--bar-height) + 32px);
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  aside h2 {
    margin-bottom: 12px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink-soft);
  }

  .project {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
  }

  .project:hover {
    color: var(--accent-text);
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      animation: grow linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes grow {
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    aside {
      position: static;
    }

    aside :global(.toc) {
      display: none;
    }
  }
</style>
