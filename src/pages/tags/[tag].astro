---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import RelatedList from '~/components/ui/RelatedList.astro';
import { getTags, type Kind } from '~/lib/tags';

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map(tag => ({ params: { tag: tag.slug }, props: { tag } }));
}

const { tag } = Astro.props;
const groups: { kind: Kind; title: string }[] = [
  { kind: 'project', title: 'Projects' },
  { kind: 'post', title: 'Posts' },
  { kind: 'event', title: 'Events' },
  { kind: 'photo', title: 'Photos' },
];
const byDate = (a: { date?: Date }, b: { date?: Date }) =>
  (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0);
---

<BaseLayout
  title={`#${tag.label}`}
  description={`Everything tagged ${tag.label}.`}
>
  <SectionHead title={`#${tag.label}`} href="/tags" linkLabel="All tags">
    <span>{tag.items.length} items</span>
  </SectionHead>
  {groups.map(group => (
    <RelatedList
      title={group.title}
      items={tag.items.filter(i => i.kind === group.kind).sort(byDate)}
    />
  ))}
  <div class="space"></div>
</BaseLayout>

<style>
  .space {
    height: 64px;
  }
</style>
