---
import RelatedList from '~/components/ui/RelatedList.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getTags, type Kind } from '~/lib/tags';

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map(tag => ({ params: { tag: tag.slug }, props: { tag } }));
}

const { tag } = Astro.props;
const groups: { kind: Kind; title: string }[] = [
  { kind: 'project', title: 'Projects' },
  { kind: 'post', title: 'Posts' },
  { kind: 'event', title: 'Events' },
  { kind: 'album', title: 'Albums' },
];
const byDate = (a: { date?: Date }, b: { date?: Date }) =>
  (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0);
---

<BaseLayout
  title={`#${tag.label}`}
  description={`Everything tagged ${tag.label}.`}
>
  <section class="container page">
    <SectionHead
      title={`#${tag.label}`}
      href="/tags"
      linkLabel="All tags"
      as="h1"
    />
  </section>
  {groups.map(group => (
    <RelatedList
      title={group.title}
      items={tag.items.filter(item => item.kind === group.kind).sort(byDate)}
    />
  ))}
</BaseLayout>

<style>
  .page {
    padding-top: clamp(48px, 7vw, 96px);
  }
</style>
