---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import { getTags } from '~/lib/tags';

const tags = await getTags();
const max = Math.max(1, ...tags.map(t => t.items.length));
const size = (count: number) => 20 + Math.round(Math.sqrt(count / max) * 76);
---

<BaseLayout title="Tags" description="Everything on the site by topic.">
  <SectionHead title="Tags" as="h1" />
  <ul class="cloud wrap">
    {tags.map(tag => (
      <li>
        <a
          href={`/tags/${tag.slug}`}
          style={`font-size:${size(tag.items.length)}px`}
        >
          <span class="display">{tag.label}</span>
          <sup class="mono">{tag.items.length}</sup>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 28px;
    margin: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    line-height: 1;
  }

  .display {
    transition: color 0.2s;
  }

  a:hover .display {
    color: var(--accent-text);
  }

  sup {
    margin-left: 4px;
    color: var(--ink-soft);
  }
</style>
