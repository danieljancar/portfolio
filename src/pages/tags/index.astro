---
import SectionHead from '~/components/ui/SectionHead.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getTags } from '~/lib/tags';

const tags = await getTags();
---

<BaseLayout title="Tags" description="Everything on the site by topic.">
  <section class="container page">
    <SectionHead title="Tags" as="h1">
      <p>Posts, projects, events and albums, grouped by topic.</p>
    </SectionHead>
    <ul class="tags">
      {tags.map(tag => (
        <li>
          <a href={`/tags/${tag.slug}`}>
            #{tag.label}
            <span>{tag.items.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(48px, 7vw, 96px);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 18px;
    font-weight: 500;
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  a span {
    font-size: 14px;
    color: var(--ink-soft);
  }

  a:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  a:hover span {
    color: inherit;
  }
</style>
