---
import EventTickets from '~/components/lists/EventTickets.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getEvents } from '~/lib/content';

const events = await getEvents();
---

<BaseLayout title="Events" description="Events Daniel Jancar was part of.">
  <SectionHead title="Events" as="h1" />
  <EventTickets events={events} />
</BaseLayout>
