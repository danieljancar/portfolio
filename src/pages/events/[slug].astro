---
import { getEntry, render } from 'astro:content';
import Gallery from '~/components/media/Gallery.astro';
import Cover from '~/components/media/Cover.astro';
import ButtonLink from '~/components/ui/ButtonLink.astro';
import RelatedList from '~/components/ui/RelatedList.astro';
import TagList from '~/components/ui/TagList.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getEvents } from '~/lib/content';
import { formatDate } from '~/lib/dates';
import { getAlbum } from '~/lib/photos';
import { getRelated } from '~/lib/tags';
import '~/styles/prose.css';

export async function getStaticPaths() {
  const events = await getEvents();
  return events.map(event => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const { title, date, endDate, place, cover, coverAlt, tags, links } =
  event.data;
const album = event.data.album
  ? await getAlbum(event.data.album.id)
  : undefined;
const project = event.data.project
  ? await getEntry(event.data.project)
  : undefined;
const related = await getRelated('event', event.id, {
  limit: 4,
  kinds: ['post', 'project', 'event'],
});
const when = endDate
  ? `${formatDate(date)} to ${formatDate(endDate)}`
  : formatDate(date);
---

<BaseLayout
  title={title}
  description={place ? `${when}, ${place}` : when}
  image={cover?.src}
>
  <article class="container page">
    <a class="back" href="/events">
      ← Events
    </a>
    <h1>{title}</h1>
    <p class="meta">
      <span>{when}</span>
      {place && <span>{place}</span>}
    </p>
    {cover && (
      <div class="cover">
        <Cover
          src={cover}
          alt={coverAlt}
          widths={[800, 1400, 2200]}
          sizes="(max-width: 1400px) 100vw, 1320px"
          loading="eager"
        />
      </div>
    )}
    <div class="body">
      <div class="prose">
        <Content />
      </div>
      <aside>
        {links.map(link => (
          <ButtonLink href={link.href} variant="outline">
            {link.label} ↗
          </ButtonLink>
        ))}
        {project && (
          <ButtonLink href={`/projects/${project.id}`} variant="outline">
            {project.data.name}
          </ButtonLink>
        )}
        <TagList tags={tags} />
      </aside>
    </div>
    {album && (
      <section class="album">
        <h2>Photos</h2>
        <Gallery photos={album.photos} label={album.data.title} />
      </section>
    )}
  </article>
  <RelatedList items={related} />
</BaseLayout>

<style>
  .page {
    padding-top: clamp(40px, 6vw, 80px);
  }

  .back {
    font-weight: 500;
    color: var(--ink-soft);
  }

  .back:hover {
    color: var(--accent-text);
  }

  h1 {
    max-width: 18ch;
    margin-top: 20px;
    font-size: clamp(40px, 6.4vw, 88px);
    letter-spacing: -0.04em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 16px;
    font-weight: 500;
    color: var(--accent-text);
  }

  .cover {
    margin-top: 40px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 680px) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    padding-top: 48px;
  }

  aside {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 16px;
  }

  .album {
    padding-top: clamp(56px, 7vw, 96px);
  }

  .album h2 {
    margin-bottom: 28px;
    font-size: clamp(32px, 4vw, 48px);
  }

  @media (max-width: 860px) {
    .body {
      grid-template-columns: 1fr;
    }
  }
</style>
