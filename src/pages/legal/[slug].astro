---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formatDate } from '~/lib/dates';
import '~/styles/prose.css';

export async function getStaticPaths() {
  const docs = await getCollection('legal');
  return docs.map(doc => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<BaseLayout title={doc.data.title} description={doc.data.description}>
  <article class="container page">
    <p class="meta">
      Version {doc.data.version}, updated {formatDate(doc.data.updated)}
    </p>
    <h1>{doc.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    max-width: calc(760px + 2 * var(--gutter));
    padding-top: clamp(48px, 7vw, 96px);
  }

  .meta {
    font-weight: 500;
    color: var(--accent-text);
  }

  h1 {
    margin: 12px 0 40px;
    font-size: clamp(40px, 6vw, 72px);
  }
</style>
