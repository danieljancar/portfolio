---
import SectionHead from '~/components/ui/SectionHead.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getRecommendations } from '~/lib/content';

const items = await getRecommendations();
const groups = [
  {
    title: 'Listening',
    items: items.filter(item => item.data.kind === 'podcast'),
  },
  {
    title: 'Reading',
    items: items.filter(item => item.data.kind !== 'podcast'),
  },
].filter(group => group.items.length > 0);
---

<BaseLayout
  title="Recommended"
  description="Podcasts, sites and newsletters Daniel Jancar recommends."
>
  <section class="container page">
    <SectionHead title="Recommended" as="h1">
      <p>Podcasts, sites and newsletters I keep coming back to.</p>
    </SectionHead>
    {groups.length === 0 && (
      <p class="muted">The first picks are coming soon.</p>
    )}
    {groups.map(group => (
      <div class="group">
        <h2>{group.title}</h2>
        <ul>
          {group.items.map(item => (
            <li>
              <a href={item.data.url} target="_blank" rel="noopener noreferrer">
                <span class="name">{item.data.name} ↗</span>
                <span class="topic">{item.data.topic}</span>
                {item.data.note && <span class="note">{item.data.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(48px, 7vw, 96px);
  }

  .group + .group {
    margin-top: 64px;
  }

  h2 {
    margin-bottom: 16px;
    font-size: clamp(28px, 3vw, 40px);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 6px 32px;
    padding-block: 20px;
    border-top: 1px solid var(--line);
  }

  .name {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
  }

  a:hover .name {
    color: var(--accent-text);
  }

  .topic {
    font-weight: 500;
    color: var(--accent-text);
  }

  .note {
    grid-column: 1 / -1;
    color: var(--ink-soft);
  }
</style>
