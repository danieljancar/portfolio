---
import { Image } from 'astro:assets';
import Experience from '~/components/experience/Experience.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getSettings } from '~/lib/content';
import { getRoles } from '~/lib/experience';
import { linkAttrs } from '~/lib/links';

const [settings, roles] = await Promise.all([getSettings(), getRoles()]);
const paragraphs = settings.about.split(/\n\s*\n/);
---

<BaseLayout title="About" description={settings.description}>
  <SectionHead title="About" as="h1" />
  <section class="intro wrap">
    {settings.portrait && (
      <div class="portrait">
        <Image
          src={settings.portrait}
          alt={settings.portraitAlt}
          widths={[200, 400]}
          sizes="160px"
          loading="eager"
        />
      </div>
    )}
    <div class="text">
      {paragraphs.map(paragraph => (
        <p>{paragraph}</p>
      ))}
      <ul class="socials mono">
        {settings.socials.map(link => (
          <li>
            <a href={link.href} {...linkAttrs(link.href)}>
              {link.label} ↗
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SectionHead title="Experience" id="experience" />
  <Experience roles={roles} />

  <SectionHead title="Skills" />
  <div class="skills wrap">
    {settings.skills.map(group => (
      <div class="group">
        <p class="mono soft">{group.group}</p>
        <ul>
          {group.items.map(item => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 160px minmax(0, 62ch);
    gap: 32px;
    align-items: start;
  }

  .portrait {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 20px;
    line-height: 1.5;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .socials a {
    display: inline-block;
    padding: 8px 12px;
    border: 1px solid var(--line);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .socials a:hover {
    background: var(--ink);
    color: var(--ground);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }

  .group ul {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .group li {
    padding: 6px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 17px;
  }

  @media (max-width: 900px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .intro {
      grid-template-columns: 1fr;
    }

    .portrait {
      width: 120px;
    }
  }
</style>
