---
import { Image } from 'astro:assets';
import ButtonLink from '~/components/ui/ButtonLink.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getExperience, getSettings } from '~/lib/content';
import { formatYearMonth } from '~/lib/dates';
import { linkAttrs } from '~/lib/links';

const [settings, experience] = await Promise.all([
  getSettings(),
  getExperience(),
]);
const paragraphs = settings.about.split(/\n\s*\n/);
const period = (start?: string, end?: string) => {
  if (!start) return end ? `Until ${formatYearMonth(end)}` : 'Ongoing';
  return `${formatYearMonth(start)} to ${end ? formatYearMonth(end) : 'today'}`;
};
---

<BaseLayout title="About" description={settings.description}>
  <section class="container intro">
    <div class="text">
      <p class="eyebrow">About</p>
      <h1>{settings.headline}</h1>
      <div class="about">
        {paragraphs.map(paragraph => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="actions">
        {settings.socials.map((link, i) => (
          <ButtonLink href={link.href} variant={i === 0 ? 'solid' : 'outline'}>
            {link.label} ↗
          </ButtonLink>
        ))}
        <ButtonLink href={`mailto:${settings.email}`} variant="outline">
          Email
        </ButtonLink>
      </div>
    </div>
    {settings.portrait && (
      <div class="portrait">
        <Image
          src={settings.portrait}
          alt={settings.portraitAlt}
          widths={[500, 800, 1200]}
          sizes="(max-width: 860px) 90vw, 35vw"
          loading="eager"
        />
      </div>
    )}
  </section>

  <section class="container block">
    <h2>Experience</h2>
    <ol class="timeline">
      {experience.map(job => (
        <li>
          <p class="period">{period(job.data.start, job.data.end)}</p>
          <div>
            <h3>{job.data.role}</h3>
            <p class="company">
              {job.data.companyUrl ? (
                <a
                  href={job.data.companyUrl}
                  {...linkAttrs(job.data.companyUrl)}
                >
                  {job.data.company}
                </a>
              ) : (
                job.data.company
              )}
            </p>
            {job.data.summary && <p class="summary">{job.data.summary}</p>}
            {job.data.skills.length > 0 && (
              <ul class="chips">
                {job.data.skills.map(skill => (
                  <li>{skill}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="container block">
    <h2>Skills</h2>
    <div class="skills">
      {settings.skills.map(group => (
        <div>
          <h3>{group.group}</h3>
          <ul class="chips">
            {group.items.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="container block more">
    <a href="/now">
      <span class="label">Now</span>
      <span class="value">{settings.now}</span>
    </a>
    <a href="/recommended">
      <span class="label">Recommended</span>
      <span class="value">Podcasts, sites and newsletters I like.</span>
    </a>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    padding-top: clamp(48px, 7vw, 96px);
  }

  h1 {
    margin-top: 16px;
    font-size: clamp(40px, 5.4vw, 76px);
    letter-spacing: -0.035em;
  }

  .about {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 60ch;
    margin-top: 28px;
    font-size: 19px;
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  .portrait {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .block {
    padding-top: clamp(72px, 9vw, 128px);
  }

  .block > h2 {
    margin-bottom: clamp(24px, 4vw, 48px);
    font-size: clamp(40px, 6vw, 76px);
    letter-spacing: -0.03em;
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline > li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: 12px 40px;
    padding-block: 32px;
    border-top: 1px solid var(--line);
  }

  .period {
    font-weight: 500;
    color: var(--accent-text);
  }

  .timeline h3 {
    font-size: clamp(24px, 2.6vw, 32px);
  }

  .company {
    margin-top: 6px;
    font-weight: 600;
  }

  .company a:hover {
    color: var(--accent-text);
  }

  .summary {
    max-width: 64ch;
    margin-top: 14px;
    color: var(--ink-soft);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--surface);
    font-size: 14px;
    font-weight: 500;
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px clamp(24px, 4vw, 64px);
  }

  .skills h3 {
    font-size: 24px;
  }

  .more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .more a {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--surface);
    transition: background 0.2s;
  }

  .more a:hover {
    background: var(--surface-2);
  }

  .label {
    font-weight: 600;
    color: var(--accent-text);
  }

  .value {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.3;
  }

  @media (max-width: 860px) {
    .intro,
    .timeline > li,
    .skills,
    .more {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: 380px;
    }
  }
</style>
