---
import type { CollectionEntry } from 'astro:content';
import Cover from '~/components/media/Cover.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  large?: boolean;
}

const { project, large = false } = Astro.props;
const { name, tagline, kind, year, cover, coverAlt } = project.data;
---

<a class:list={['card', { large }]} href={`/projects/${project.id}`}>
  <div class="media">
    {cover && (
      <Cover
        src={cover}
        alt={coverAlt}
        widths={[600, 900, 1400]}
        sizes={
          large
            ? '(max-width: 860px) 100vw, 60vw'
            : '(max-width: 860px) 100vw, 33vw'
        }
      />
    )}
  </div>
  <div class="text">
    <div class="meta">
      <span>{kind}</span>
      {year && <span>{year}</span>}
    </div>
    <h3>{name}</h3>
    <p>{tagline}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .large .media {
    aspect-ratio: 16 / 10;
  }

  .media :global(img) {
    transition:
      transform 0.7s var(--ease-out),
      filter 0.5s var(--ease-out);
  }

  .card:hover .media :global(img) {
    transform: scale(1.04);
  }

  .meta {
    display: flex;
    gap: 14px;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent-text);
  }

  h3 {
    margin-top: 6px;
    font-size: clamp(26px, 2.6vw, 34px);
  }

  .large h3 {
    font-size: clamp(32px, 4vw, 52px);
  }

  p {
    margin-top: 6px;
    color: var(--ink-soft);
  }
</style>
