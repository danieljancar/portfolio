---
import Cover from '~/components/media/Cover.astro';
import { formatMonth } from '~/lib/dates';
import type { Album } from '~/lib/photos';

interface Props {
  album: Album;
}

const { album } = Astro.props;
---

<a class="card" href={`/photos/${album.id}`}>
  <div class="media">
    <Cover
      src={album.data.cover}
      alt=""
      widths={[500, 800, 1200]}
      sizes="(max-width: 860px) 100vw, 50vw"
    />
  </div>
  <div class="text">
    <h3>{album.data.title}</h3>
    <p>{formatMonth(album.data.date)}</p>
  </div>
</a>

<style>
  .card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 4 / 3;
  }

  .media {
    position: absolute;
    inset: 0;
  }

  .media :global(img) {
    transition:
      transform 0.8s var(--ease-out),
      filter 0.5s var(--ease-out);
  }

  .card:hover .media :global(img) {
    transform: scale(1.05);
  }

  .text {
    position: absolute;
    inset: auto 0 0;
    padding: 64px 22px 20px;
    color: #f4f3ee;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.6));
  }

  h3 {
    font-size: clamp(24px, 2.6vw, 34px);
  }

  p {
    margin-top: 4px;
    font-size: 15px;
    opacity: 0.85;
  }
</style>
