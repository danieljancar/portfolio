---
import { render, type CollectionEntry } from 'astro:content';
import Cover from '~/components/media/Cover.astro';
import { formatDate } from '~/lib/dates';
import { linkAttrs } from '~/lib/links';

interface Props {
  notes: CollectionEntry<'notes'>[];
}

const { notes } = Astro.props;
const rendered = await Promise.all(
  notes.map(async note => ({ note, ...(await render(note)) })),
);
---

<ol class="notes wrap">
  {rendered.map(({ note, Content }) => (
    <li class="note">
      <time class="mono" datetime={note.data.date.toISOString()}>
        {formatDate(note.data.date)}
      </time>
      <div class="text">
        <Content />
        {note.data.link && (
          <a
            class="mono"
            href={note.data.link.href}
            {...linkAttrs(note.data.link.href)}
          >
            {note.data.link.label} →
          </a>
        )}
      </div>
      {note.data.image && (
        <div class="thumb">
          <Cover
            src={note.data.image}
            alt={note.data.imageAlt}
            widths={[300, 600]}
            sizes="240px"
          />
        </div>
      )}
    </li>
  ))}
</ol>

<style>
  .notes {
    margin: 0;
    list-style: none;
  }

  .note {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: 24px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 20px;
    line-height: 1.4;
  }

  .thumb {
    width: 240px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  @media (max-width: 700px) {
    .note {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
