---
import type { CollectionEntry } from 'astro:content';
import Cover from '~/components/media/Cover.astro';

interface Props {
  work: CollectionEntry<'projects'>[];
}

const { work } = Astro.props;
const when = ({ ongoing, year }: CollectionEntry<'projects'>['data']) =>
  ongoing ? (year ? `Since ${year}` : 'Ongoing') : year?.toString();
---

<ul class="bento" data-bento>
  {work.map((item, i) => (
    <li data-slot={i % 5} data-type={item.data.ongoing ? 'ongoing' : 'one-off'}>
      <a class="tile" href={`/work/${item.id}`}>
        <span class="arrow" aria-hidden="true">
          →
        </span>
        <div class:list={['image', !item.data.cover && 'empty']}>
          {item.data.cover ? (
            <Cover
              src={item.data.cover}
              alt=""
              widths={[400, 800, 1200]}
              sizes="(max-width: 900px) 100vw, 50vw"
            />
          ) : (
            <span class="display">{item.data.name.slice(0, 1)}</span>
          )}
        </div>
        <div class="text">
          <ul class="meta mono">
            <li class:list={[item.data.ongoing && 'live']}>
              {item.data.ongoing ? 'Ongoing' : 'One-off'}
            </li>
            <li>{item.data.kind}</li>
            {when(item.data) && <li>{when(item.data)}</li>}
          </ul>
          <h3 class="display">{item.data.name}</h3>
          <p>{item.data.tagline}</p>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: 300px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  li[data-slot] {
    grid-column: span 6;
    min-height: 0;
    overflow: hidden;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  li[data-slot='0'] {
    grid-column: span 7;
    grid-row: span 2;
  }

  li[data-slot='1'],
  li[data-slot='2'] {
    grid-column: span 5;
  }

  li[hidden] {
    display: none;
  }

  .tile {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 20px;
    height: 100%;
    padding: 20px;
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .tile:hover {
    background: var(--ink);
    color: var(--ground);
  }

  li[data-slot='0'] .tile {
    grid-template-columns: 1fr;
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .arrow {
    position: absolute;
    top: 16px;
    right: 20px;
    z-index: 1;
    font-size: 20px;
    transition: transform 0.3s var(--ease-out);
  }

  .tile:hover .arrow {
    transform: rotate(-45deg);
  }

  .image {
    order: 2;
    min-height: 0;
    margin-top: 28px;
    overflow: hidden;
  }

  li[data-slot='0'] .image {
    order: 0;
  }

  .image :global(img) {
    transition: transform 0.6s var(--ease-out);
  }

  .tile:hover .image :global(img) {
    transform: scale(1.04);
  }

  .empty {
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--on-accent);
  }

  .empty span {
    font-size: 96px;
  }

  .text {
    display: flex;
    flex-direction: column;
    justify-content: end;
    gap: 12px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .live {
    color: var(--accent-text);
  }

  .tile:hover .live {
    color: var(--accent);
  }

  h3 {
    font-size: clamp(26px, 2.4vw, 40px);
    overflow-wrap: anywhere;
    transition: font-stretch 0.5s var(--ease-out);
  }

  li[data-slot='0'] h3 {
    font-size: clamp(44px, 6vw, 96px);
  }

  .tile:hover h3 {
    font-stretch: 62%;
  }

  p {
    max-width: 36ch;
    font-size: 17px;
    line-height: 1.4;
  }

  @supports (animation-timeline: view()) {
    li[data-slot] {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 80%;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }

  @media (max-width: 900px) {
    .bento {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }

    li[data-slot],
    li[data-slot='0'],
    li[data-slot='1'],
    li[data-slot='2'] {
      grid-column: auto;
      grid-row: auto;
    }

    .tile,
    li[data-slot='0'] .tile {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .image,
    li[data-slot='0'] .image {
      order: 0;
      min-height: 0;
      margin-top: 32px;
      aspect-ratio: 16 / 10;
    }
  }
</style>
