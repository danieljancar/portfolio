---
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'projects'>[];
}

const { work } = Astro.props;
const when = ({ ongoing, year }: CollectionEntry<'projects'>['data']) =>
  ongoing ? (year ? `Since ${year}` : undefined) : year?.toString();
---

<ul class="bento" data-bento>
  {work.map((item, i) => (
    <li data-slot={i % 4} data-type={item.data.ongoing ? 'ongoing' : 'one-off'}>
      <a class="tile" href={`/work/${item.id}`} data-cursor="Open">
        <ul class="meta mono">
          <li class:list={[item.data.ongoing && 'live']}>
            {item.data.ongoing ? 'Ongoing' : 'One-off'}
          </li>
          <li>{item.data.kind}</li>
          {when(item.data) && <li>{when(item.data)}</li>}
        </ul>
        <span class="arrow" aria-hidden="true">
          →
        </span>
        <h3 class="display">{item.data.name}</h3>
        <p>{item.data.tagline}</p>
      </a>
    </li>
  ))}
</ul>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(240px, auto);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  li[data-slot] {
    grid-column: span 12;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  li[data-slot='0'] {
    grid-column: span 7;
    grid-row: span 2;
  }

  li[data-slot='1'],
  li[data-slot='2'] {
    grid-column: span 5;
  }

  li[hidden] {
    display: none;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
    padding: 20px;
    overflow: hidden;
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 4px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.5s var(--ease-out);
  }

  .tile:hover {
    background: var(--ink);
    color: var(--ground);
  }

  .tile:hover::after {
    transform: scaleX(1);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0;
    padding: 0 32px 0 0;
    list-style: none;
  }

  .live {
    color: var(--accent-text);
  }

  .tile:hover .live {
    color: var(--accent);
  }

  .arrow {
    position: absolute;
    top: 16px;
    right: 20px;
    font-size: 20px;
    transition: transform 0.3s var(--ease-out);
  }

  .tile:hover .arrow {
    transform: rotate(-45deg);
  }

  h3 {
    margin-top: auto;
    font-size: clamp(36px, 4.4vw, 72px);
    transition: translate 0.45s var(--ease-out);
  }

  li[data-slot='0'] h3 {
    font-size: clamp(56px, 9vw, 150px);
  }

  li[data-slot='3'] h3 {
    font-size: clamp(44px, 6vw, 104px);
  }

  .tile:hover h3 {
    translate: 10px 0;
  }

  p {
    max-width: 40ch;
    font-size: 17px;
    line-height: 1.4;
  }

  @supports (animation-timeline: view()) {
    li[data-slot] {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 80%;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }

  @media (max-width: 900px) {
    .bento {
      grid-template-columns: 1fr;
      grid-auto-rows: minmax(200px, auto);
    }

    li[data-slot],
    li[data-slot='0'],
    li[data-slot='1'],
    li[data-slot='2'] {
      grid-column: auto;
      grid-row: auto;
    }

    h3,
    li[data-slot='0'] h3,
    li[data-slot='3'] h3 {
      font-size: clamp(30px, 10vw, 56px);
    }
  }
</style>
