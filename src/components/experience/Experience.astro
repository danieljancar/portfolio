---
import type { Role } from '~/lib/experience';
import { linkAttrs } from '~/lib/links';

interface Props {
  roles: Role[];
}

const { roles } = Astro.props;
---

<ol class="xp wrap">
  {roles.map(({ entry, current, period }) => (
    <li class:list={['role', current && 'current']}>
      <span class="node" aria-hidden="true"></span>
      <p class="mono period">{period}</p>
      <div class="body">
        <h3 class="display company">
          {entry.data.companyUrl ? (
            <a
              href={entry.data.companyUrl}
              data-cursor="Visit"
              {...linkAttrs(entry.data.companyUrl)}
            >
              {entry.data.company}
            </a>
          ) : (
            entry.data.company
          )}
        </h3>
        <p class="title">{entry.data.role}</p>
        {entry.data.summary && <p class="summary">{entry.data.summary}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .xp {
    position: relative;
    margin: 0;
    list-style: none;
    view-timeline-name: --xp;
  }

  .xp::before,
  .xp::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--gutter) + 7px);
    width: 2px;
    background: var(--line);
  }

  .xp::after {
    background: var(--accent);
    transform-origin: 50% 0;
  }

  .role {
    position: relative;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 8px 32px;
    padding: 36px 0 36px 44px;
    border-bottom: 1px solid var(--line-soft);
  }

  .node {
    position: absolute;
    top: 42px;
    left: 0;
    width: 16px;
    height: 16px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--ground);
  }

  .current .node {
    background: var(--accent);
  }

  .period {
    padding-top: 6px;
    color: var(--ink-soft);
  }

  .current .period {
    color: var(--accent-text);
  }

  .company {
    font-size: clamp(28px, 3.4vw, 52px);
    line-height: 0.95;
  }

  .company a {
    transition: font-stretch 0.45s var(--ease-out);
  }

  .company a:hover {
    font-stretch: 62%;
  }

  .title {
    margin-top: 10px;
    font-size: 20px;
    font-weight: 600;
  }

  .summary {
    max-width: 64ch;
    margin-top: 10px;
    color: var(--ink-soft);
  }

  @supports (animation-timeline: view()) {
    .xp::after {
      animation: fill linear both;
      animation-timeline: --xp;
      animation-range: entry 50% exit 50%;
    }

    .role {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 70%;
    }
  }

  @keyframes fill {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }

  @media (max-width: 800px) {
    .role {
      grid-template-columns: 1fr;
      padding-left: 36px;
    }

    .node {
      top: 38px;
    }
  }
</style>
