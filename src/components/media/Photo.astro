---
import { Image } from 'astro:assets';
import type { Photo } from '~/lib/photos';
import { dimStyle } from '~/lib/tone';

interface Props {
  photo: Photo;
  alt?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  photo,
  alt = '',
  widths = [480, 800, 1200, 1800],
  sizes = '100vw',
  class: className,
  loading = 'lazy',
} = Astro.props;
---

<Image
  src={photo.image}
  alt={alt}
  widths={widths}
  sizes={sizes}
  loading={loading}
  class:list={['photo', 'dimmed', className]}
  style={`background-color:${photo.meta.palette.dominant};${dimStyle(photo.meta.brightness)}`}
/>

<style>
  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
