---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { dimStyle, imageBrightness } from '~/lib/tone';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  widths = [480, 800, 1200, 1800],
  sizes = '100vw',
  loading = 'lazy',
  class: className,
} = Astro.props;
const style = dimStyle(await imageBrightness(src));
---

<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  loading={loading}
  class:list={['cover', 'dimmed', className]}
  style={style}
/>

<style>
  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
