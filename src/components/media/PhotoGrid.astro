---
import Photo from '~/components/media/Photo.astro';
import type { Photo as PhotoType } from '~/lib/photos';

interface Props {
  photos: PhotoType[];
}

const { photos } = Astro.props;
const size = (photo: PhotoType, i: number) => {
  const portrait = photo.meta.height > photo.meta.width;
  if (portrait) return 'tall';
  return i % 7 === 0 ? 'wide' : 'normal';
};
---

<ul class="grid wrap">
  {photos.map((photo, i) => (
    <li class={size(photo, i)} data-category={photo.data.category}>
      <a href={`/photos/${photo.id}`} aria-label={photo.data.alt || 'Photo'}>
        <Photo
          photo={photo}
          widths={[400, 700, 1000]}
          sizes="(max-width: 700px) 50vw, 25vw"
        />
      </a>
    </li>
  ))}
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: 160px;
    grid-auto-flow: dense;
    gap: 12px;
    margin: 0;
    list-style: none;
  }

  li {
    grid-column: span 2;
    grid-row: span 2;
    overflow: hidden;
  }

  .wide {
    grid-column: span 4;
  }

  .tall {
    grid-row: span 3;
  }

  li[hidden] {
    display: none;
  }

  a {
    display: block;
    height: 100%;
  }

  a :global(img) {
    transition: transform 0.6s var(--ease-out);
  }

  a:hover :global(img) {
    transform: scale(1.04);
  }

  @supports (animation-timeline: view()) {
    li {
      animation: pop linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 70%;
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.85);
    }
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 120px;
    }

    li,
    .wide {
      grid-column: span 1;
    }

    .wide {
      grid-column: span 2;
    }
  }
</style>
