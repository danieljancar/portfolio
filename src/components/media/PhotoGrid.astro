---
import Photo from '~/components/media/Photo.astro';
import type { Photo as PhotoType } from '~/lib/photos';

interface Props {
  photos: PhotoType[];
  label: string;
}

const { photos, label } = Astro.props;
const size = (photo: PhotoType, i: number) => {
  if (photo.meta.height > photo.meta.width) return 'tall';
  return i % 7 === 0 ? 'wide' : 'normal';
};
---

<ul class="grid wrap">
  {photos.map((photo, i) => (
    <li class={size(photo, i)} data-album={photo.album}>
      <a href={photo.href} data-cursor="View">
        <Photo
          photo={photo}
          alt={`${label}, photo ${i + 1} of ${photos.length}`}
          widths={[400, 700, 1000]}
          sizes="(max-width: 700px) 50vw, 33vw"
        />
      </a>
    </li>
  ))}
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: 160px;
    grid-auto-flow: dense;
    gap: 12px;
    margin: 0;
    list-style: none;
  }

  li[hidden] {
    display: none;
  }

  li {
    grid-column: span 2;
    grid-row: span 2;
    overflow: hidden;
  }

  .wide {
    grid-column: span 4;
  }

  .tall {
    grid-row: span 3;
  }

  a {
    display: block;
    height: 100%;
  }

  a :global(img) {
    transition:
      transform 0.6s var(--ease-out),
      filter 0.5s var(--ease-out);
  }

  a:hover :global(img) {
    transform: scale(1.04);
  }

  @supports (animation-timeline: view()) {
    li {
      animation: pop linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 70%;
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.85);
    }
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 120px;
    }

    li {
      grid-column: span 1;
    }

    .wide {
      grid-column: span 2;
    }
  }
</style>
