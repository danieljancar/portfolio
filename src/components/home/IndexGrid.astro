---
import type { ImageMetadata } from 'astro';
import Cover from '~/components/media/Cover.astro';
import Photo from '~/components/media/Photo.astro';
import { linkAttrs } from '~/lib/links';
import type { Photo as PhotoType } from '~/lib/photos';

interface Props {
  workImage?: ImageMetadata;
  photos: PhotoType[];
  eventImage?: ImageMetadata;
  current: string[];
  links: { label: string; href: string }[];
  recommendations: boolean;
}

const { workImage, photos, eventImage, current, links, recommendations } =
  Astro.props;
const handle = (href: string) =>
  href.startsWith('mailto:')
    ? href.slice(7)
    : href
        .replace(/^https?:\/\/(www\.)?/, '')
        .replace(/\/$/, '')
        .replace(/^[^/]+\/(in\/)?/, '@');
---

<section class="index" aria-label="Index">
  <a class="cell c5 m2 tall" href="/work" data-cursor="Work">
    <span class="arrow" aria-hidden="true">
      →
    </span>
    {workImage && (
      <div class="media big">
        <Cover
          src={workImage}
          alt=""
          widths={[500, 900]}
          sizes="(max-width: 900px) 90vw, 38vw"
        />
      </div>
    )}
    <h3 class="display">Work</h3>
  </a>

  <a class="cell c4" href="/photos" data-cursor="Photos">
    <span class="arrow" aria-hidden="true">
      →
    </span>
    <div class="strip">
      {photos.slice(0, 3).map(photo => (
        <div class="media">
          <Photo photo={photo} widths={[240, 400]} sizes="120px" />
        </div>
      ))}
    </div>
    <h3 class="display">Photos</h3>
  </a>

  <a class="cell c3 accent" href="/blog" data-cursor="Read">
    <span class="arrow" aria-hidden="true">
      →
    </span>
    <h3 class="display">Blog</h3>
  </a>

  <a class="cell c4 m2" href="/events" data-cursor="Events">
    <span class="arrow" aria-hidden="true">
      →
    </span>
    {eventImage && (
      <div class="media event">
        <Cover src={eventImage} alt="" widths={[300, 600]} sizes="240px" />
      </div>
    )}
    <h3 class="display">Events</h3>
  </a>

  <a class="cell c3 m2" href="/about#experience" data-cursor="About">
    <span class="arrow" aria-hidden="true">
      →
    </span>
    <ul class="current">
      {current.map(name => (
        <li>{name}</li>
      ))}
    </ul>
    <h3 class="display small">About</h3>
  </a>

  {recommendations && (
    <>
      <a class="cell c6" href="/recommended#listening">
        <span class="arrow" aria-hidden="true">
          →
        </span>
        <h3 class="display small">Listen</h3>
      </a>
      <a class="cell c6" href="/recommended#reading">
        <span class="arrow" aria-hidden="true">
          →
        </span>
        <h3 class="display small">Read</h3>
      </a>
    </>
  )}

  {links.map(link => (
    <a
      class="cell c3 social"
      href={link.href}
      data-cursor="Open"
      {...linkAttrs(link.href)}
    >
      <span class="arrow out" aria-hidden="true">
        ↗
      </span>
      <span class="mono">{handle(link.href)}</span>
      <h3 class="display small">{link.label}</h3>
    </a>
  ))}
</section>

<style>
  .index {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .cell {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    min-height: 240px;
    padding: 20px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .cell:hover {
    background: var(--ink);
    color: var(--ground);
  }

  .c3 {
    grid-column: span 3;
  }

  .c4 {
    grid-column: span 4;
  }

  .c5 {
    grid-column: span 5;
  }

  .c6 {
    grid-column: span 6;
  }

  .tall {
    grid-row: span 2;
  }

  .accent {
    justify-content: end;
    background: var(--accent);
    color: var(--on-accent);
  }

  h3 {
    font-size: clamp(36px, 3.6vw, 52px);
  }

  h3.small {
    font-size: clamp(30px, 3vw, 40px);
  }

  .arrow {
    position: absolute;
    top: 16px;
    right: 20px;
    font-size: 20px;
    transition: transform 0.3s var(--ease-out);
  }

  .cell:hover .arrow {
    transform: rotate(-45deg);
  }

  .media {
    overflow: hidden;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .cell:hover .media :global(img) {
    transform: scale(1.05);
  }

  .big {
    flex-grow: 1;
    max-height: 340px;
    margin-top: 28px;
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    max-width: 380px;
    margin-top: 28px;
  }

  .strip .media {
    aspect-ratio: 3 / 4;
  }

  .event {
    width: 200px;
    aspect-ratio: 3 / 2;
  }

  .current {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    font-size: 17px;
    font-weight: 500;
  }

  .social {
    min-height: 150px;
  }

  .social .mono {
    padding-right: 24px;
    overflow-wrap: anywhere;
  }

  .cell:hover .out {
    transform: translate(3px, -3px);
  }

  @supports (animation-timeline: view()) {
    .cell {
      animation: fade linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 90%;
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .c3,
    .c4,
    .c5,
    .c6 {
      grid-column: span 1;
    }

    .m2 {
      grid-column: span 2;
    }

    .tall {
      grid-row: auto;
    }

    .cell {
      min-height: 180px;
      padding: 16px;
    }

    h3,
    h3.small {
      font-size: clamp(24px, 7.4vw, 40px);
    }

    .social h3.small {
      font-size: clamp(18px, 5.2vw, 30px);
    }

    .social {
      min-height: 120px;
    }

    .big {
      max-height: 260px;
    }

    .event {
      width: 100%;
    }
  }
</style>
