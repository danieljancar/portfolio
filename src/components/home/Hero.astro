---
import ButtonLink from '~/components/ui/ButtonLink.astro';
import Photo from '~/components/media/Photo.astro';
import type { Photo as PhotoType } from '~/lib/photos';

interface Props {
  headline: string;
  intro: string;
  photos: PhotoType[];
}

const { headline, intro, photos } = Astro.props;
const stack = photos.slice(0, 3);
---

<section class="hero container">
  <div class="text">
    <p class="eyebrow">Daniel Jancar</p>
    <h1>{headline}</h1>
    <p class="intro">{intro}</p>
    <div class="actions">
      <ButtonLink href="/projects">See my projects</ButtonLink>
      <ButtonLink href="/about" variant="outline">
        More about me
      </ButtonLink>
    </div>
  </div>
  <div class="stack" aria-hidden="true">
    {stack.map((photo, i) => (
      <div class="card" style={`--i:${i}`}>
        <Photo
          photo={photo}
          widths={[400, 700, 1000]}
          sizes="(max-width: 860px) 60vw, 26vw"
          loading="eager"
        />
      </div>
    ))}
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
    min-height: calc(100svh - var(--bar-height));
    padding-block: 48px 72px;
  }

  h1 {
    margin-top: 18px;
    font-size: clamp(44px, 6.4vw, 92px);
    letter-spacing: -0.035em;
    line-height: 0.98;
    animation: rise 0.9s var(--ease-out) both;
  }

  .intro {
    max-width: 52ch;
    margin-top: 28px;
    font-size: clamp(18px, 1.6vw, 21px);
    color: var(--ink-soft);
    animation: rise 0.9s 0.12s var(--ease-out) both;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
    animation: rise 0.9s 0.24s var(--ease-out) both;
  }

  .stack {
    position: relative;
    aspect-ratio: 4 / 5;
    width: min(100%, 520px);
    justify-self: center;
  }

  .card {
    position: absolute;
    inset: 8% 14%;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.35);
    transform: rotate(calc((var(--i) - 1) * 7deg))
      translateX(calc((var(--i) - 1) * 18%));
    transition: transform 0.8s var(--ease-out);
    animation: deal 1s calc(0.2s + var(--i) * 0.12s) var(--ease-out) backwards;
  }

  .card:nth-child(2) {
    z-index: 2;
  }

  .stack:hover .card {
    transform: rotate(calc((var(--i) - 1) * 11deg))
      translateX(calc((var(--i) - 1) * 32%));
  }

  @supports (animation-timeline: scroll()) {
    .stack {
      animation: drift linear both;
      animation-timeline: scroll(root);
      animation-range: 0 80vh;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @keyframes deal {
    from {
      opacity: 0;
      transform: translateY(40px) rotate(0);
    }
  }

  @keyframes drift {
    to {
      transform: translateY(-8%) rotate(-3deg);
    }
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 40px;
    }

    .stack {
      width: min(80%, 380px);
    }
  }
</style>
