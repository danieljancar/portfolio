---
import Photo from '~/components/media/Photo.astro';
import type { Photo as PhotoType } from '~/lib/photos';

interface Props {
  photos: PhotoType[];
  video?: string;
  tagline: string;
}

const { photos, video, tagline } = Astro.props;
const ring = photos.slice(0, 10);
const step = 360 / Math.max(ring.length, 1);
---

<section class="hero" aria-label="Intro">
  {video && (
    <video
      class="video"
      src={video}
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    />
  )}
  <div class="stage" aria-hidden="true">
    <div class="tilt">
      <div class="ring">
        {ring.map((photo, i) => (
          <div class="card" style={`--angle:${i * step}deg`}>
            <Photo
              photo={photo}
              widths={[240, 360]}
              sizes="180px"
              loading="eager"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="name">
    <div class="meta">
      <p>{tagline}</p>
      <span class="mono">Scroll ↓</span>
    </div>
    <h1 class="display">
      Daniel
      <br />
      Jancar
    </h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: calc(100svh - var(--bar-height));
    min-height: 620px;
    overflow: hidden;
    background: var(--night);
    color: var(--night-ink);
  }

  .video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
  }

  .stage {
    position: absolute;
    left: 50%;
    top: 44%;
    perspective: 1400px;
  }

  .tilt,
  .ring {
    transform-style: preserve-3d;
  }

  .tilt {
    transform: rotateX(-8deg);
  }

  .ring {
    animation: turn 48s linear infinite;
  }

  .card {
    position: absolute;
    left: -90px;
    top: -120px;
    width: 180px;
    height: 240px;
    transform: rotateY(var(--angle)) translateZ(430px);
    outline: 1px solid rgb(255 255 255 / 0.15);
  }

  .name {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    padding: 0 var(--gutter) var(--gutter);
    color: #fff;
    mix-blend-mode: difference;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 18px;
  }

  .meta p {
    max-width: 420px;
    font-size: 18px;
    line-height: 1.35;
  }

  h1 {
    font-size: 17.5vw;
  }

  @supports (animation-timeline: scroll()) {
    .tilt {
      animation: tilt-away linear both;
      animation-timeline: scroll(root);
      animation-range: 0 100vh;
    }

    .name {
      animation: lift linear both;
      animation-timeline: scroll(root);
      animation-range: 0 90vh;
    }
  }

  @keyframes turn {
    to {
      transform: rotateY(-360deg);
    }
  }

  @keyframes tilt-away {
    to {
      transform: rotateX(-38deg) scale(0.7);
    }
  }

  @keyframes lift {
    to {
      transform: translateY(-12vh);
    }
  }

  @media (max-width: 700px) {
    .card {
      left: -60px;
      top: -80px;
      width: 120px;
      height: 160px;
      transform: rotateY(var(--angle)) translateZ(260px);
    }

    .meta {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
