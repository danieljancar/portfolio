---
import { getImage } from 'astro:assets';
import { fit } from '~/lib/fit';
import { linkProps } from '~/lib/links';
import type { Photo } from '~/lib/photos';

interface Props {
  photos: Photo[];
  tagline: string;
  links: { label: string; href: string }[];
}

const { photos, tagline, links } = Astro.props;
const pool = await Promise.all(
  photos
    .slice(0, 24)
    .map(
      async photo =>
        (await getImage({ src: photo.image, width: 720, format: 'webp' })).src,
    ),
);
const tiles = pool.slice(0, 8);
---

<section class="hero" aria-label="Intro" data-hero>
  <ul class="wall" aria-hidden="true" data-wall>
    {tiles.map((src, i) => (
      <li>
        <img
          src={src}
          alt=""
          loading={i < 4 ? 'eager' : 'lazy'}
          decoding="async"
        />
      </li>
    ))}
  </ul>
  <script
    type="application/json"
    data-pool
    set:html={JSON.stringify(pool)}
  ></script>
  <div class="name">
    <div class="meta">
      <p>{tagline}</p>
      <ul class="links mono">
        {links.map(link => (
          <li>
            <a {...linkProps(link.href)}>{link.label} ↗</a>
          </li>
        ))}
      </ul>
    </div>
    <h1 class="display" style={fit('Daniel Jancar')}>
      Daniel
      <br />
      Jancar
    </h1>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-hero]');
  const wall = root?.querySelector<HTMLElement>('[data-wall]');
  const data = root?.querySelector('[data-pool]')?.textContent;
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && wall && data && !still) {
    const pool = JSON.parse(data) as string[];
    const tiles = [...wall.children] as HTMLElement[];
    let visible = true;
    let last: HTMLElement | undefined;

    new IntersectionObserver(([entry]) => {
      visible = Boolean(entry?.isIntersecting);
    }).observe(root);

    const shown = () =>
      new Set(
        tiles.map(tile =>
          tile.querySelector('img:last-child')?.getAttribute('src'),
        ),
      );

    const swap = () => {
      if (!visible || document.hidden) return;
      const options = tiles.filter(
        tile => tile.offsetParent && tile !== last && !tile.dataset.busy,
      );
      const tile = options[Math.floor(Math.random() * options.length)];
      const used = shown();
      const next = pool.filter(src => !used.has(src));
      const src = next[Math.floor(Math.random() * next.length)];
      if (!tile || !src) return;
      last = tile;
      tile.dataset.busy = 'true';
      const incoming = new Image();
      incoming.alt = '';
      incoming.decoding = 'async';
      incoming.src = src;
      incoming.decode().then(
        () => {
          const outgoing = tile.querySelector('img');
          tile.append(incoming);
          incoming.getBoundingClientRect();
          tile.classList.add('rolling');
          setTimeout(() => {
            outgoing?.remove();
            tile.classList.remove('rolling');
            delete tile.dataset.busy;
          }, 1500);
        },
        () => delete tile.dataset.busy,
      );
    };

    setInterval(swap, 2200);
  }
</script>

<style>
  .hero {
    position: relative;
    height: calc(100svh - var(--bar-height));
    min-height: 620px;
    overflow: hidden;
    background: var(--night);
    color: #fff;
  }

  .wall {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wall::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(6 7 5 / 0.9), rgb(6 7 5 / 0.3) 65%),
      rgb(6 7 5 / 0.45);
  }

  .wall li {
    position: relative;
    overflow: hidden;
  }

  .wall :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: translate 1.4s cubic-bezier(0.7, 0, 0.2, 1);
  }

  .wall :global(img + img) {
    translate: 0 100%;
  }

  .rolling :global(img:first-child) {
    translate: 0 -100%;
  }

  .rolling :global(img + img) {
    translate: 0 0;
  }

  .name {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    padding: 0 var(--gutter) var(--gutter);
    container-type: inline-size;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-block;
    padding: 6px 0;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px
      no-repeat;
    transition: background-size 0.35s var(--ease-out);
  }

  .links a:hover {
    color: inherit;
    background-size: 100% 1px;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 18px;
  }

  .meta p {
    max-width: 440px;
    font-size: 20px;
    line-height: 1.3;
  }

  h1 {
    font-size: min(17.5vw, 100cqi / (var(--chars, 1) * 1.06));
  }

  @supports (animation-timeline: scroll()) {
    .name {
      animation: lift linear both;
      animation-timeline: scroll(root);
      animation-range: 0 90vh;
    }
  }

  @keyframes lift {
    to {
      transform: translateY(-12vh);
    }
  }

  @media (max-width: 700px) {
    .wall {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(3, minmax(0, 1fr));
    }

    .wall li:nth-child(n + 7) {
      display: none;
    }

    .meta {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
