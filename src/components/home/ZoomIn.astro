---
import Photo from '~/components/media/Photo.astro';
import type { Album, Photo as PhotoType } from '~/lib/photos';

interface Props {
  center: PhotoType;
  around: PhotoType[];
  album: Album;
}

const { center, around, album } = Astro.props;
const positions = [
  { w: '22vw', h: '28vh', x0: '-30vw', y0: '-26vh', x1: '-80vw', y1: '-70vh' },
  { w: '18vw', h: '24vh', x0: '30vw', y0: '-28vh', x1: '80vw', y1: '-70vh' },
  { w: '16vw', h: '30vh', x0: '-34vw', y0: '22vh', x1: '-90vw', y1: '70vh' },
  { w: '20vw', h: '22vh', x0: '32vw', y0: '26vh', x1: '90vw', y1: '70vh' },
];
const flyers = around
  .slice(0, positions.length)
  .map((photo, i) => ({ photo, ...positions[i] }));
---

<section class="zoom" aria-label={album.data.title}>
  <div class="stick">
    {flyers.map(f => (
      <div
        class="flyer"
        style={`width:${f.w};height:${f.h};--x0:${f.x0};--y0:${f.y0};--x1:${f.x1};--y1:${f.y1}`}
      >
        <Photo photo={f.photo} widths={[480, 800]} sizes="25vw" />
      </div>
    ))}
    <div class="center">
      <Photo photo={center} widths={[800, 1400, 2000, 2400]} sizes="100vw" />
    </div>
    <a class="caption container" href={`/photos/${album.id}`}>
      <span class="title">{album.data.title}</span>
      <span class="link">Open the album →</span>
    </a>
  </div>
</section>

<style>
  .zoom {
    position: relative;
    height: 320vh;
    view-timeline-name: --zoom;
  }

  .stick {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .flyer {
    position: absolute;
    left: 50%;
    top: 50%;
    overflow: hidden;
    border-radius: 14px;
    transform: translate(-50%, -50%) translate(var(--x0), var(--y0)) scale(0.6);
  }

  .center {
    position: absolute;
    inset: 0;
    clip-path: inset(34% 38% round 24px);
  }

  .caption {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    max-width: none;
    padding-block: 120px 36px;
    color: #f4f3ee;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.55));
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 64px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .link {
    font-weight: 600;
    white-space: nowrap;
  }

  @supports (animation-timeline: view()) {
    .flyer {
      animation: fly linear both;
      animation-timeline: --zoom;
      animation-range: contain 0% contain 100%;
    }

    .center {
      animation: open linear both;
      animation-timeline: --zoom;
      animation-range: contain 0% contain 80%;
    }

    .caption {
      animation: show linear both;
      animation-timeline: --zoom;
      animation-range: contain 60% contain 90%;
    }
  }

  @supports not (animation-timeline: view()) {
    .zoom {
      height: auto;
    }

    .stick {
      position: relative;
      height: 80vh;
    }

    .flyer {
      display: none;
    }

    .center {
      clip-path: none;
    }
  }

  @keyframes fly {
    to {
      transform: translate(-50%, -50%) translate(var(--x1), var(--y1))
        scale(2.4);
      opacity: 0;
    }
  }

  @keyframes open {
    to {
      clip-path: inset(0 0 round 0);
    }
  }

  @keyframes show {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }
</style>
