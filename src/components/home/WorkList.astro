---
import Cover from '~/components/media/Cover.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<ol class="work wrap">
  {projects.map((project, i) => (
    <li>
      <a class="row" href={`/work/${project.id}`}>
        <span class="mono">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h3 class="display">{project.data.name}</h3>
          <div class="tags mono">
            <span>{project.data.kind}</span>
            <span>{project.data.tagline}</span>
            <span>{project.data.stack.join(' · ')}</span>
          </div>
        </div>
        <div
          class:list={[
            'shape',
            `shape-${project.data.shape}`,
            !project.data.cover && 'empty',
          ]}
        >
          {project.data.cover ? (
            <Cover
              src={project.data.cover}
              alt={project.data.coverAlt}
              widths={[320, 640]}
              sizes="320px"
            />
          ) : (
            <span class="display">{project.data.name.slice(0, 1)}</span>
          )}
        </div>
      </a>
    </li>
  ))}
</ol>

<style>
  .work {
    margin: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 80px 1fr 260px;
    gap: 32px;
    align-items: center;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    transform-origin: 50% 100%;
  }

  li:first-child .row {
    border-top: 1px solid var(--line);
  }

  h3 {
    font-size: clamp(44px, 7vw, 120px);
    transition: font-stretch 0.5s var(--ease-out);
  }

  .row:hover {
    color: inherit;
  }

  .row:hover h3 {
    font-stretch: 62%;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 10px;
  }

  .shape {
    height: 220px;
    overflow: hidden;
  }

  .empty {
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--on-accent);
  }

  .empty span {
    font-size: 96px;
  }

  @supports (animation-timeline: view()) {
    .row {
      animation: stand-up linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 35%;
    }
  }

  @keyframes stand-up {
    from {
      opacity: 0;
      transform: perspective(1200px) rotateX(70deg);
    }
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .shape {
      max-width: 240px;
      height: 180px;
    }
  }
</style>
