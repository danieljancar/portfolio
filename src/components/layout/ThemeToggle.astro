<button
  class="toggle"
  type="button"
  data-theme-toggle
  aria-label="Switch colour theme"
>
  <svg
    class="sun"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
    <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </g>
  </svg>
  <svg
    class="moon"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    aria-hidden="true"
  >
    <path
      d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"
      fill="currentColor"
    ></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const current = () =>
    root.dataset.theme ?? (media.matches ? 'dark' : 'light');

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    '[data-theme-toggle]',
  )) {
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // storage can be unavailable in private windows
      }
    });
  }
</script>

<style>
  .toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color 0.2s,
      transform 0.4s var(--ease-out);
  }

  .toggle:hover {
    border-color: var(--accent);
    transform: rotate(20deg);
  }

  .toggle svg {
    grid-area: 1 / 1;
    transition:
      opacity 0.3s,
      transform 0.5s var(--ease-out);
  }

  .moon {
    opacity: calc(1 - var(--is-dark));
    transform: rotate(calc(var(--is-dark) * -90deg))
      scale(calc(1 - var(--is-dark) * 0.5));
  }

  .sun {
    opacity: var(--is-dark);
    transform: rotate(calc((1 - var(--is-dark)) * 90deg))
      scale(calc(0.5 + var(--is-dark) * 0.5));
  }
</style>
