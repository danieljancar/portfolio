---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/work', label: 'Work' },
  { href: '/photos', label: 'Photos' },
  { href: '/events', label: 'Events' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
const current = (href: string) =>
  path === href || path.startsWith(`${href}/`) ? 'page' : undefined;
---

<header class="bar">
  <a class="wordmark" href="/" aria-label="Daniel Jancar, home">
    daniel<span>.</span>jancar
  </a>

  <nav class="desktop" aria-label="Main">
    {links.map(link => (
      <a href={link.href} aria-current={current(link.href)}>
        {link.label}
      </a>
    ))}
  </nav>

  <div class="actions">
    <ThemeToggle />
    <button class="burger" type="button" popovertarget="menu" aria-label="Menu">
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<nav id="menu" class="menu" popover aria-label="Menu">
  <div class="menu-top">
    <a class="wordmark" href="/">
      daniel<span>.</span>jancar
    </a>
    <button
      class="close"
      type="button"
      popovertarget="menu"
      popovertargetaction="hide"
      aria-label="Close menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
  <ul>
    {links.map((link, i) => (
      <li style={`--i:${i}`}>
        <a class="display" href={link.href} aria-current={current(link.href)}>
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--bar-height);
    padding-inline: var(--gutter);
    background: var(--ground);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.3s;
  }

  .wordmark {
    justify-self: start;
    font-size: 19px;
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: -0.02em;
  }

  .wordmark span {
    color: var(--accent);
  }

  .wordmark:hover {
    color: inherit;
  }

  .desktop {
    display: flex;
    gap: 2px;
  }

  .desktop a {
    padding: 8px 12px;
    font-size: 14px;
    font-weight: 500;
  }

  .desktop a:hover,
  .desktop a[aria-current='page'] {
    background: var(--ink);
    color: var(--ground);
  }

  .actions {
    display: flex;
    gap: 8px;
    justify-self: end;
    align-items: center;
  }

  .burger,
  .close {
    position: relative;
    display: none;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line);
    background: transparent;
    cursor: pointer;
  }

  .burger span,
  .close span {
    position: absolute;
    left: 11px;
    width: 16px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.4s var(--ease-out);
  }

  .burger span:first-child {
    top: 15px;
  }

  .burger span:last-child {
    top: 21px;
  }

  .burger:hover span:first-child {
    transform: translateX(3px);
  }

  .burger:hover span:last-child {
    transform: translateX(-3px);
  }

  .close {
    display: block;
    border-color: rgb(11 13 10 / 0.35);
  }

  .close span {
    top: 18px;
    background: var(--on-accent);
  }

  .close span:first-child {
    transform: rotate(45deg);
  }

  .close span:last-child {
    transform: rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter);
    border: 0;
    background: var(--green);
    color: var(--on-accent);
    clip-path: circle(0 at calc(100% - 40px) 28px);
    transition:
      clip-path 0.6s var(--ease-out),
      display 0.6s allow-discrete,
      overlay 0.6s allow-discrete;
  }

  .menu:popover-open {
    clip-path: circle(150% at calc(100% - 40px) 28px);
  }

  @starting-style {
    .menu:popover-open {
      clip-path: circle(0 at calc(100% - 40px) 28px);
    }
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--bar-height);
    border-bottom: 1px solid rgb(11 13 10 / 0.3);
  }

  .menu .wordmark span {
    color: var(--ground);
  }

  .menu ul {
    margin: 0;
    padding: 4vh 0 0;
    list-style: none;
  }

  .menu li {
    overflow: hidden;
    border-bottom: 1px solid rgb(11 13 10 / 0.3);
  }

  .menu li a {
    display: block;
    padding: 10px 0 4px;
    font-size: clamp(44px, 14vw, 96px);
    transform: translateY(110%);
    transition:
      transform 0.6s var(--ease-out) calc(0.15s + var(--i) * 0.06s),
      font-stretch 0.4s var(--ease-out);
  }

  .menu li a:hover {
    color: inherit;
    font-stretch: 62%;
  }

  .menu:popover-open li a {
    transform: none;
  }

  @starting-style {
    .menu:popover-open li a {
      transform: translateY(110%);
    }
  }

  .menu li a[aria-current='page'] {
    color: var(--ground);
  }

  @media (max-width: 820px) {
    .bar {
      grid-template-columns: 1fr auto;
    }

    .desktop {
      display: none;
    }

    .burger {
      display: block;
    }
  }
</style>
