---
import SocialIcon from '~/components/ui/SocialIcon.astro';
import { getSettings } from '~/lib/content';
import { linkAttrs } from '~/lib/links';
import ThemeToggle from './ThemeToggle.astro';

const settings = await getSettings();
const socials = [
  ...settings.socials,
  { label: 'Email', href: `mailto:${settings.email}` },
];

const links = [
  { href: '/work', label: 'Work' },
  { href: '/photos', label: 'Photos' },
  { href: '/events', label: 'Events' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
const current = (href: string) =>
  path === href || path.startsWith(`${href}/`) ? 'page' : undefined;
const letters = [...'daniel.jancar'];
const home = path === '/';
---

<header class="bar" data-bar>
  <a class="wordmark" href="/" aria-label="Daniel Jancar, home">
    {letters.map((letter, i) => (
      <span class:list={['char', letter === '.' && 'dot']} style={`--c:${i}`}>
        <span>{letter}</span>
        <span aria-hidden="true">{letter}</span>
      </span>
    ))}
  </a>

  <nav class="desktop" aria-label="Main" data-nav>
    <span class="pill" aria-hidden="true" data-pill></span>
    {links.map(link => (
      <a
        href={link.href}
        aria-current={current(link.href)}
        data-magnetic
        data-cursor=""
      >
        <span class="roll">
          <span>{link.label}</span>
          <span aria-hidden="true">{link.label}</span>
        </span>
      </a>
    ))}
  </nav>

  <div class="actions">
    {home && (
      <ul class="socials">
        {socials.map(link => (
          <li>
            <a
              href={link.href}
              aria-label={link.label}
              data-magnetic
              data-cursor=""
              {...linkAttrs(link.href)}
            >
              <SocialIcon href={link.href} />
            </a>
          </li>
        ))}
      </ul>
    )}
    <ThemeToggle />
    <button
      class="burger"
      type="button"
      popovertarget="menu"
      aria-label="Menu"
      data-magnetic
    >
      <span></span>
      <span></span>
    </button>
  </div>
  <span class="progress" aria-hidden="true"></span>
</header>

<nav id="menu" class="menu" popover aria-label="Menu">
  <div class="menu-top">
    <a class="wordmark" href="/">
      daniel<span class="dot">.</span>jancar
    </a>
    <button
      class="close"
      type="button"
      popovertarget="menu"
      popovertargetaction="hide"
      aria-label="Close menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
  <ul>
    {links.map((link, i) => (
      <li style={`--i:${i}`}>
        <a class="display" href={link.href} aria-current={current(link.href)}>
          {link.label}
        </a>
      </li>
    ))}
  </ul>
  <div class="menu-bottom">
    <ul class="menu-socials">
      {socials.map(link => (
        <li>
          <a href={link.href} aria-label={link.label} {...linkAttrs(link.href)}>
            <SocialIcon href={link.href} size={26} />
          </a>
        </li>
      ))}
    </ul>
    <p class="mono">
      © {new Date().getFullYear()} {settings.name}
    </p>
  </div>
</nav>

<script>
  const bar = document.querySelector<HTMLElement>('[data-bar]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const pill = document.querySelector<HTMLElement>('[data-pill]');

  if (bar) {
    let last = window.scrollY;
    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        bar.classList.toggle('tucked', y > last && y > 240);
        last = y;
      },
      { passive: true },
    );
  }

  if (nav && pill) {
    const place = (link: HTMLElement | null) => {
      if (!link) {
        pill.style.opacity = '0';
        return;
      }
      pill.style.opacity = '1';
      pill.style.width = `${link.offsetWidth}px`;
      pill.style.translate = `${link.offsetLeft}px 0`;
    };
    const active = () =>
      nav.querySelector<HTMLElement>('[aria-current="page"]');
    for (const link of nav.querySelectorAll<HTMLElement>('a')) {
      link.addEventListener('pointerenter', () => place(link));
      link.addEventListener('focus', () => place(link));
    }
    nav.addEventListener('pointerleave', () => place(active()));
    window.addEventListener('resize', () => place(active()));
    document.fonts.ready.then(() => place(active()));
    place(active());
    requestAnimationFrame(() => nav.classList.add('ready'));
  }
</script>

<style>
  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--bar-height);
    padding-inline: var(--gutter);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid var(--line);
    transition:
      translate 0.45s var(--ease-out),
      background-color 0.3s;
  }

  .bar.tucked {
    translate: 0 -100%;
  }

  .bar:has(:focus-visible) {
    translate: none;
  }

  .progress {
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .wordmark {
    display: inline-flex;
    justify-self: start;
    font-size: 20px;
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .wordmark:hover {
    color: inherit;
  }

  .char {
    display: inline-grid;
    overflow: hidden;
  }

  .char span {
    grid-area: 1 / 1;
    transition:
      translate 0.5s var(--ease-out) calc(var(--c) * 22ms),
      font-stretch 0.5s var(--ease-out) calc(var(--c) * 22ms);
  }

  .char span + span {
    translate: 0 110%;
    font-stretch: 62%;
    color: var(--accent);
  }

  .wordmark:hover .char span:first-child {
    translate: 0 -110%;
  }

  .wordmark:hover .char span + span {
    translate: 0 0;
    font-stretch: 125%;
  }

  .dot,
  .dot span {
    color: var(--accent);
  }

  .desktop {
    position: relative;
    display: flex;
    gap: 2px;
  }

  .pill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    background: var(--ink);
    opacity: 0;
    pointer-events: none;
  }

  .desktop.ready .pill {
    transition:
      translate 0.45s var(--ease-out),
      width 0.45s var(--ease-out),
      opacity 0.3s;
  }

  .desktop a {
    position: relative;
    padding: 8px 14px;
    font-size: 14px;
    font-weight: 600;
    transition:
      color 0.3s,
      translate 0.3s var(--ease-out);
  }

  .desktop a:hover,
  .desktop a:focus-visible,
  .desktop:not(:hover) a[aria-current='page'] {
    color: var(--ground);
  }

  .desktop:hover a[aria-current='page']:not(:hover) {
    color: inherit;
  }

  .roll {
    display: inline-grid;
    overflow: hidden;
    vertical-align: top;
  }

  .roll span {
    grid-area: 1 / 1;
    transition: translate 0.45s var(--ease-out);
  }

  .roll span + span {
    translate: 0 105%;
  }

  .desktop a:hover .roll span:first-child {
    translate: 0 -105%;
  }

  .desktop a:hover .roll span + span {
    translate: 0 0;
  }

  .socials,
  .menu-socials {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .socials {
    gap: 2px;
    margin-right: 6px;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    color: var(--ink-soft);
    transition:
      color 0.2s,
      translate 0.3s var(--ease-out);
  }

  .socials a:hover {
    color: var(--accent-text);
  }

  .menu {
    display: none;
    flex-direction: column;
  }

  .menu:popover-open {
    display: flex;
  }

  .menu-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: auto;
    padding: 20px 0 calc(20px + env(safe-area-inset-bottom));
    border-top: 1px solid rgb(11 13 10 / 0.3);
  }

  .menu-socials {
    gap: 8px;
  }

  .menu-socials a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(11 13 10 / 0.35);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .menu-socials a:hover {
    background: var(--on-accent);
    color: var(--accent);
  }

  .actions {
    display: flex;
    gap: 8px;
    justify-self: end;
    align-items: center;
  }

  .burger,
  .close {
    position: relative;
    display: none;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line);
    background: transparent;
    cursor: pointer;
  }

  .burger span,
  .close span {
    position: absolute;
    left: 11px;
    width: 16px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.4s var(--ease-out);
  }

  .burger span:first-child {
    top: 15px;
  }

  .burger span:last-child {
    top: 21px;
  }

  .burger:hover span:first-child {
    transform: translateX(3px);
  }

  .burger:hover span:last-child {
    transform: translateX(-3px);
  }

  .close {
    display: block;
    border-color: rgb(11 13 10 / 0.35);
  }

  .close span {
    top: 18px;
    background: var(--on-accent);
  }

  .close span:first-child {
    transform: rotate(45deg);
  }

  .close span:last-child {
    transform: rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter);
    border: 0;
    background: var(--green);
    color: var(--on-accent);
    clip-path: circle(0 at calc(100% - 40px) 28px);
    transition:
      clip-path 0.6s var(--ease-out),
      display 0.6s allow-discrete,
      overlay 0.6s allow-discrete;
  }

  .menu:popover-open {
    clip-path: circle(150% at calc(100% - 40px) 28px);
  }

  @starting-style {
    .menu:popover-open {
      clip-path: circle(0 at calc(100% - 40px) 28px);
    }
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--bar-height);
    border-bottom: 1px solid rgb(11 13 10 / 0.3);
  }

  .menu .wordmark,
  .menu .dot {
    color: var(--on-accent);
  }

  .menu ul {
    margin: 0;
    padding: 4vh 0 0;
    list-style: none;
  }

  .menu li {
    overflow: hidden;
    border-bottom: 1px solid rgb(11 13 10 / 0.3);
  }

  .menu li a {
    display: block;
    padding: 10px 0 4px;
    font-size: clamp(44px, 14vw, 96px);
    transform: translateY(110%);
    transition:
      transform 0.6s var(--ease-out) calc(0.15s + var(--i) * 0.06s),
      font-stretch 0.4s var(--ease-out);
  }

  .menu li a:hover {
    color: inherit;
    font-stretch: 62%;
  }

  .menu:popover-open li a {
    transform: none;
  }

  @starting-style {
    .menu:popover-open li a {
      transform: translateY(110%);
    }
  }

  .menu li a[aria-current='page'] {
    color: var(--ground);
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      animation: progress linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 820px) {
    .bar {
      grid-template-columns: 1fr auto;
    }

    .desktop,
    .socials {
      display: none;
    }

    .burger {
      display: block;
    }
  }
</style>
