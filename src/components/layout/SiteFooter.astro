---
import { getCollection } from 'astro:content';
import { getSettings } from '~/lib/content';
import { linkAttrs } from '~/lib/links';

const settings = await getSettings();
const legal = await getCollection('legal');
const more = [
  { href: '/now', label: 'Now' },
  { href: '/recommended', label: 'Recommended' },
  { href: '/tags', label: 'Tags' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<footer class="foot">
  <div class="container">
    <p class="lead">Let's talk.</p>
    <a class="mail" href={`mailto:${settings.email}`}>
      {settings.email}
    </a>

    <div class="columns">
      <nav aria-label="Profiles">
        {settings.socials.map(link => (
          <a href={link.href} {...linkAttrs(link.href)}>
            {link.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
      <nav aria-label="More">
        {more.map(link => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
      <nav aria-label="Legal">
        {legal.map(doc => (
          <a href={`/legal/${doc.id}`}>{doc.data.title}</a>
        ))}
      </nav>
    </div>

    <p class="copy">
      © {new Date().getFullYear()} {settings.name}
    </p>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(80px, 10vw, 140px);
    padding-block: 72px 32px;
    background: var(--green);
    color: var(--on-accent);
  }

  .lead {
    font-size: 18px;
    font-weight: 500;
  }

  .mail {
    display: inline-block;
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: clamp(32px, 6vw, 72px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    word-break: break-word;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 3px
      no-repeat;
    transition: background-size 0.4s var(--ease-out);
  }

  .mail:hover {
    background-size: 100% 3px;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin-top: 64px;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  nav a {
    width: fit-content;
    font-weight: 500;
  }

  nav a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .copy {
    margin-top: 56px;
    font-size: 14px;
    opacity: 0.75;
  }

  @media (max-width: 640px) {
    .columns {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
