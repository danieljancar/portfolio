---
import Photo from '~/components/media/Photo.astro';
import type { Album } from '~/lib/photos';

interface Props {
  album: Album;
}

const { album } = Astro.props;
const photos = album.photos.slice(-6).reverse();
const areas = 'abcdef';
---

<ul class="bento" data-count={photos.length}>
  {photos.map((photo, i) => (
    <li style={`grid-area:${areas[i]}`}>
      <a
        href={photo.href}
        aria-label={`${album.data.title}, photo ${i + 1}`}
        data-cursor="View"
      >
        <Photo
          photo={photo}
          widths={[300, 600, 900]}
          sizes={
            i === 0
              ? '(max-width: 900px) 70vw, 30vw'
              : '(max-width: 900px) 35vw, 15vw'
          }
          loading={i < 3 ? 'eager' : 'lazy'}
        />
      </a>
    </li>
  ))}
</ul>

<style>
  .bento {
    position: sticky;
    top: calc(var(--bar-height) + 24px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: minmax(0, 1fr);
    gap: 10px;
    height: min(76svh, 760px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [data-count='1'] {
    grid-template-areas: 'a a a';
  }

  [data-count='2'] {
    grid-template-areas: 'a a b';
  }

  [data-count='3'] {
    grid-template-areas: 'a a b' 'a a c';
  }

  [data-count='4'] {
    grid-template-areas: 'a a b' 'a a c' 'd d c';
  }

  [data-count='5'] {
    grid-template-areas: 'a a b' 'a a c' 'd e c';
  }

  [data-count='6'] {
    grid-template-areas: 'a a b' 'a a c' 'd e f';
  }

  li {
    min-height: 0;
    overflow: hidden;
  }

  a {
    display: block;
    height: 100%;
  }

  a :global(img) {
    transition: transform 0.8s var(--ease-out);
  }

  a:hover :global(img) {
    transform: scale(1.05);
  }

  @media (max-width: 900px) {
    .bento {
      position: static;
      height: auto;
      grid-auto-rows: 150px;
    }

    li:first-child {
      min-height: 300px;
    }
  }
</style>
