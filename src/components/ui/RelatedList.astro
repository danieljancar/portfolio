---
import Cover from '~/components/media/Cover.astro';
import { formatMonth } from '~/lib/dates';
import { kindLabels, type Item } from '~/lib/related';

interface Props {
  items: Item[];
  title?: string;
}

const { items, title = 'Related' } = Astro.props;
---

{items.length > 0 && (
  <section class="related wrap" aria-label={title}>
    <h2 class="display">{title}</h2>
    <ul>
      {items.map(item => (
        <li>
          <a class="card" href={item.href}>
            {item.image && (
              <div class="thumb">
                <Cover
                  src={item.image}
                  alt=""
                  widths={[400, 700]}
                  sizes="(max-width: 700px) 100vw, 25vw"
                />
              </div>
            )}
            <div class="line mono">
              <span>{kindLabels[item.kind]}</span>
              {item.date && <span>{formatMonth(item.date)}</span>}
            </div>
            <h3>{item.title}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related {
    padding-top: 64px;
  }

  h2 {
    margin-bottom: 24px;
    font-size: clamp(40px, 6vw, 88px);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card:hover {
    color: inherit;
  }

  .thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-2);
  }

  .thumb :global(img) {
    transition: transform 0.6s var(--ease-out);
  }

  .card:hover .thumb :global(img) {
    transform: scale(1.04);
  }

  .line {
    display: flex;
    justify-content: space-between;
    color: var(--ink-soft);
  }

  h3 {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
  }

  .card:hover h3 {
    color: var(--accent-text);
  }
</style>
