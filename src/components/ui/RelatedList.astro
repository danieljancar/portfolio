---
import Cover from '~/components/media/Cover.astro';
import { formatMonth } from '~/lib/dates';
import { kindLabels, type Item } from '~/lib/related';

interface Props {
  items: Item[];
  title?: string;
}

const { items, title = 'Related' } = Astro.props;
---

{items.length > 0 && (
  <section class="related container" aria-label={title}>
    <h2>{title}</h2>
    <ul>
      {items.map(item => (
        <li>
          <a class="card" href={item.href}>
            <div class="thumb">
              {item.image && (
                <Cover
                  src={item.image}
                  alt=""
                  widths={[400, 700]}
                  sizes="(max-width: 700px) 100vw, 25vw"
                />
              )}
            </div>
            <p class="meta">
              <span>{kindLabels[item.kind]}</span>
              {item.date && <span>{formatMonth(item.date)}</span>}
            </p>
            <h3>{item.title}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related {
    padding-top: clamp(64px, 8vw, 96px);
  }

  h2 {
    margin-bottom: 28px;
    font-size: clamp(32px, 4vw, 48px);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 28px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 14px;
    background: var(--surface);
  }

  .meta {
    display: flex;
    gap: 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent-text);
  }

  h3 {
    font-size: 20px;
    line-height: 1.25;
  }

  .card:hover h3 {
    color: var(--accent-text);
  }
</style>
