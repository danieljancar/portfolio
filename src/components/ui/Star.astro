---
interface Props {
  size?: number;
  color?: string;
}
const { size = 150, color = 'var(--accent)' } = Astro.props;
---

<svg
  class="star"
  width={size}
  height={size}
  viewBox="0 0 100 100"
  aria-hidden="true"
>
  <path
    d="M50 0 L56 38 L93 22 L62 47 L100 60 L60 60 L70 98 L50 66 L30 98 L40 60 L0 60 L38 47 L7 22 L44 38 Z"
    fill={color}
  ></path>
</svg>

<style>
  .star {
    animation: spin 24s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
