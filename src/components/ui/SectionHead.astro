---
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
  as?: 'h1' | 'h2';
}

const { title, href, linkLabel = 'See all', as: Tag = 'h2' } = Astro.props;
---

<div class="head">
  <div>
    <Tag>{title}</Tag>
    <slot />
  </div>
  {href && (
    <a class="more" href={href}>
      {linkLabel}
      <span aria-hidden="true">→</span>
    </a>
  )}
</div>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px 32px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  h1,
  h2 {
    font-size: clamp(40px, 6vw, 76px);
    letter-spacing: -0.03em;
  }

  .more {
    flex-shrink: 0;
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-weight: 500;
    transition:
      border-color 0.2s,
      background 0.2s;
  }

  .more span {
    display: inline-block;
    margin-left: 4px;
    transition: transform 0.3s var(--ease-out);
  }

  .more:hover {
    border-color: var(--accent);
  }

  .more:hover span {
    transform: translateX(4px);
  }

  .head :global(p) {
    max-width: 58ch;
    margin-top: 16px;
    font-size: 19px;
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .head {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
