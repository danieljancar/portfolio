---
import { icons } from '@iconify-json/ri';
import { getIconData, iconToHTML, iconToSVG } from '@iconify/utils';
import { socialIcon } from '~/lib/social';

interface Props {
  href: string;
  size?: number;
}

const { href, size = 20 } = Astro.props;
const data = getIconData(icons, socialIcon(href));
const svg = data ? iconToSVG(data, { height: size, width: size }) : undefined;
---

{svg && (
  <Fragment
    set:html={iconToHTML(svg.body, {
      ...svg.attributes,
      'aria-hidden': 'true',
      fill: 'currentColor',
    })}
  />
)}
