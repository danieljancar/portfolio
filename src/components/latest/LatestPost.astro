---
import type { CollectionEntry } from 'astro:content';
import Cover from '~/components/media/Cover.astro';
import { readingTime } from '~/lib/content';
import { formatDate } from '~/lib/dates';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, published, cover, tags } = post.data;
---

<article class="latest wrap">
  <a class="card" href={`/blog/${post.id}`} data-cursor="Read">
    <div class="visual">
      <span class="disc" aria-hidden="true"></span>
      <div class="shape">
        {cover && (
          <Cover
            src={cover}
            alt=""
            widths={[500, 900]}
            sizes="(max-width: 900px) 80vw, 40vw"
          />
        )}
      </div>
      <svg class="badge" viewBox="0 0 200 200" aria-hidden="true">
        <defs>
          <path
            id="latest-badge"
            d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0"
          />
        </defs>
        <circle cx="100" cy="100" r="98" />
        <text>
          <textPath href="#latest-badge" textLength="462">
            Latest post ✦ Latest post ✦ Latest post ✦
          </textPath>
        </text>
      </svg>
    </div>
    <div class="text">
      <ul class="meta mono">
        <li>{formatDate(published)}</li>
        <li>{readingTime(post.body)} min read</li>
      </ul>
      <h3 class="display">{title}</h3>
      <p>{description}</p>
      <ul class="tags mono">
        {tags.slice(0, 4).map(tag => (
          <li>#{tag}</li>
        ))}
      </ul>
      <span class="more mono">Read the post →</span>
    </div>
  </a>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .card:hover {
    color: inherit;
  }

  .visual {
    position: relative;
    aspect-ratio: 4 / 5;
  }

  .disc {
    position: absolute;
    right: -8%;
    bottom: -6%;
    width: 64%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    transition: translate 0.6s var(--ease-out);
  }

  .card:hover .disc {
    translate: 6% -4%;
  }

  .shape {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: inset(0 round 999px 999px 0 0);
  }

  .shape :global(img) {
    transition: transform 0.8s var(--ease-out);
  }

  .card:hover .shape :global(img) {
    transform: scale(1.06);
  }

  .badge {
    position: absolute;
    top: -6%;
    left: -8%;
    width: 34%;
    animation: spin 22s linear infinite;
  }

  .badge circle {
    fill: var(--ink);
  }

  .badge text {
    fill: var(--ground);
    font-family: var(--font-mono);
    font-size: 17px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .meta,
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .meta {
    color: var(--accent-text);
  }

  .tags {
    color: var(--ink-soft);
  }

  h3 {
    font-size: clamp(40px, 5.6vw, 96px);
    transition: font-stretch 0.5s var(--ease-out);
  }

  .card:hover h3 {
    font-stretch: 62%;
  }

  p {
    max-width: 52ch;
    font-size: 20px;
    line-height: 1.45;
  }

  .more {
    display: inline-block;
    width: fit-content;
    padding: 12px 16px;
    background: var(--ink);
    color: var(--ground);
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .card:hover .more {
    background: var(--accent);
    color: var(--on-accent);
  }

  @supports (animation-timeline: view()) {
    .shape {
      animation: reveal linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 45%;
    }

    .disc {
      animation: roll linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 50%;
    }

    .text > * {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 35%;
    }
  }

  @keyframes reveal {
    from {
      clip-path: inset(12% 18% round 999px);
    }
    to {
      clip-path: inset(0 round 999px 999px 0 0);
    }
  }

  @keyframes roll {
    from {
      transform: translate(-60%, 30%) scale(0.2);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 900px) {
    .card {
      grid-template-columns: 1fr;
    }

    .visual {
      width: min(100%, 420px);
      margin-inline: auto;
    }
  }
</style>
