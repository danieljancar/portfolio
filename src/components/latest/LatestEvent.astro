---
import type { CollectionEntry } from 'astro:content';
import Cover from '~/components/media/Cover.astro';
import { formatDay, formatMonth } from '~/lib/dates';

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const { title, date, place, cover, coverAlt } = event.data;
---

<div class="wrap">
  <a class="ticket" href={`/events/${event.id}`} data-cursor="Open">
    <div class="stub">
      <span class="display day">{formatDay(date)}</span>
      <span class="mono">{formatMonth(date)}</span>
    </div>
    <div class="main">
      {place && <span class="mono soft">{place}</span>}
      <h3 class="display">{title}</h3>
      <span class="more mono">Story and photos →</span>
    </div>
    <div class="image">
      {cover && (
        <Cover
          src={cover}
          alt={coverAlt}
          widths={[500, 900, 1200]}
          sizes="(max-width: 900px) 100vw, 40vw"
        />
      )}
    </div>
  </a>
</div>

<style>
  .ticket {
    --cut: 200px;
    display: grid;
    grid-template-columns: var(--cut) minmax(0, 1fr) minmax(0, 0.9fr);
    min-height: 420px;
    background: var(--surface);
    mask:
      radial-gradient(circle 18px at var(--cut) 0, #0000 98%, #000) top / 100%
        51% no-repeat,
      radial-gradient(circle 18px at var(--cut) 100%, #0000 98%, #000) bottom /
        100% 51% no-repeat;
    transform-origin: 50% 100%;
  }

  .ticket:hover {
    color: inherit;
  }

  .stub {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    border-right: 2px dashed var(--ground);
    background: var(--accent);
    color: var(--on-accent);
    transform-origin: 100% 100%;
    transition: rotate 0.5s var(--ease-out);
  }

  .ticket:hover .stub {
    rotate: -4deg;
  }

  .day {
    font-size: clamp(88px, 9vw, 150px);
  }

  .main {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 16px;
    padding: 28px;
  }

  h3 {
    font-size: clamp(32px, 3.6vw, 60px);
    transition: font-stretch 0.5s var(--ease-out);
  }

  .ticket:hover h3 {
    font-stretch: 62%;
  }

  .more {
    color: var(--accent-text);
  }

  .image {
    overflow: hidden;
  }

  .image :global(img) {
    transition: transform 0.8s var(--ease-out);
  }

  .ticket:hover .image :global(img) {
    transform: scale(1.06);
  }

  @supports (animation-timeline: view()) {
    .ticket {
      animation: print linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 40%;
    }
  }

  @keyframes print {
    from {
      opacity: 0;
      transform: perspective(1400px) rotateX(55deg) translateY(80px);
    }
  }

  @media (max-width: 900px) {
    .ticket {
      --cut: 120px;
      grid-template-columns: var(--cut) minmax(0, 1fr);
    }

    .image {
      grid-column: 1 / -1;
      aspect-ratio: 16 / 10;
    }

    .day {
      font-size: 64px;
    }

    .main {
      padding: 20px;
    }
  }
</style>
