---
import '~/styles/base.css';
import SiteFooter from '~/components/layout/SiteFooter.astro';
import Cursor from '~/components/layout/Cursor.astro';
import SiteHeader from '~/components/layout/SiteHeader.astro';
import type { ImageMetadata } from 'astro';
import { getSettings } from '~/lib/content';
import { identity, shareImage, type Schema } from '~/lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  article?: { published: Date; modified?: Date; tags: string[] };
  schema?: Schema[];
  themeStyle?: string;
  noindex?: boolean;
}

const site = Astro.site ?? new URL('https://danieljancar.dev');
const settings = await getSettings();
const {
  title,
  description = settings.description,
  image,
  imageAlt = title ?? settings.name,
  article,
  schema = [],
  themeStyle,
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} | ${settings.name}` : settings.name;
const canonical = new URL(Astro.url.pathname, site);
const share = await shareImage(image, site);
const graph = {
  '@context': 'https://schema.org',
  '@graph': [...(await identity(site)), ...schema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      const readTheme = () => {
        try {
          return localStorage.getItem('theme');
        } catch {
          return null;
        }
      };
      const stored = readTheme();
      if (stored === 'light' || stored === 'dark')
        document.documentElement.dataset.theme = stored;
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={settings.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={share.url} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={imageAlt} />
    {article && (
      <>
        <meta
          property="article:published_time"
          content={article.published.toISOString()}
        />
        {article.modified && (
          <meta
            property="article:modified_time"
            content={article.modified.toISOString()}
          />
        )}
        <meta property="article:author" content={settings.name} />
        {article.tags.map(tag => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={share.url} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(graph)}
    ></script>
    <meta
      name="theme-color"
      content="#ecebe4"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0b0d0a"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${settings.name} blog`}
      href="/rss.xml"
    />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
  </head>
  <body style={themeStyle}>
    <a class="skip mono" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <Cursor />
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 10px 14px;
    background: var(--ink);
    color: var(--ground);
    transform: translateY(-200%);
  }

  .skip:focus {
    transform: none;
  }

  main {
    padding-top: var(--bar-height);
  }
</style>
